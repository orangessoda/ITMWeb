{
  "case_goal": "Verify that an admin can login and perform a search entry test by navigating to day view, clearing search field, typing 'test', clearing again, and pressing Enter.",
  "summary": "Login as admin, navigate to day view, clear and type 'test' into search field, then clear and submit with Enter key.",
  "steps": [
    {
      "action_type": "get",
      "target": "http://mrbs-old.local:8094/admin.php",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login page displayed with username and password fields."
    },
    {
      "action_type": "clear",
      "target": "//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field filled with 'admin'."
    },
    {
      "action_type": "clear",
      "target": "//*[@id=\"password\"]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Admin panel visible with navigation links (Report, Import, Rooms, Users)."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"form_nav\"]/input[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Page remains admin.php, no navigation."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"form_nav\"]/input[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Page remains admin.php, same state."
    },
    {
      "action_type": "click",
      "target": "/html/body/div[2]/div[2]/div/div[2]/div/span[6]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/index.php?csrf_token=...&view=day&area=2&page_date=2026-05-01",
      "expected_result": "Day view page loaded."
    },
    {
      "action_type": "clear",
      "target": "//*[@id=\"header_search\"]/input[9]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/index.php?view=day&area=2&page_date=2026-05-01",
      "expected_result": "Search field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"header_search\"]/input[9]",
      "value": "test",
      "page_url": "http://mrbs-old.local:8094/index.php?view=day&area=2&page_date=2026-05-01",
      "expected_result": "Search field contains 'test'."
    },
    {
      "action_type": "clear",
      "target": "//*[@id=\"header_search\"]/input[9]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/index.php?view=day&area=2&page_date=2026-05-01",
      "expected_result": "Search field cleared again."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"header_search\"]/input[9]",
      "value": "\\ue007",
      "page_url": "http://mrbs-old.local:8094/index.php?view=day&area=2&page_date=2026-05-01",
      "expected_result": "Search submitted via Enter key."
    }
  ]
}