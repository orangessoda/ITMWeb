{
  "case_goal": "Search for a user by username in the user management page",
  "summary": "The test logs in as admin, navigates to the Users page, and uses the search filter to find the user 'admin'.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login page displayed with username and password fields"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field filled with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login successful, admin panel displayed with navigation links"
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/header/nav/nav[1]/nav[1]/a[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Users management page displayed with search filter"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"users_table_filter\"]/label/input",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Search input filled with 'admin', table filters to show matching users"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"users_table_filter\"]/label/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Search input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"users_table_filter\"]/label/input",
      "value": "\\ue007",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Enter key pressed, possibly triggering search or reset"
    }
  ]
}