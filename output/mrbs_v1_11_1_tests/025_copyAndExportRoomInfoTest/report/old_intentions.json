{
  "case_goal": "Copy and export room information from the rooms management page.",
  "summary": "Log in as admin to MRBS, navigate to the Rooms page, and click the Copy and Export buttons to copy and export room details.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "page opened"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"username\"]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "clear succeeded"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "typing succeeded"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"password\"]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "clear succeeded"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "typing succeeded"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "click succeeded"
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/header/nav/nav[1]/nav[1]/a[4]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "click succeeded"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"rooms_table_wrapper\"]/div[1]/button[4]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Copy button clicked, room info copied"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"rooms_table_wrapper\"]/div[1]/button[5]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Export button clicked, room info exported"
    }
  ]
}