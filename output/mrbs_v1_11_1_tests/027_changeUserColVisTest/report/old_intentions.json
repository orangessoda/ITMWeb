    {
      "action_type": "click",
      "target": "Rights column toggle button",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Rights column visibility is toggled"
    },
    {
      "action_type": "click",
      "target": "Email address column toggle button",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Email address column visibility is toggled"
    },
    {
      "action_type": "click",
      "target": "Page body",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
