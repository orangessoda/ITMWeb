{
  "case_goal": "Test the ability to show/hide columns in the users data table on the Users management page.",
  "summary": "Log in as admin, navigate to the Users page, open the column visibility dropdown, and toggle visibility of Username, Rights, and Email address columns, then close the dropdown.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Admin page is loaded with login form visible"
    },
    {
      "action_type": "clear",
      "target": "username field",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field is cleared"
    },
    {
      "action_type": "send_keys",
      "target": "username field",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field contains 'admin'"
    },
    {
      "action_type": "clear",
      "target": "password field",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field is cleared"
    },
    {
      "action_type": "send_keys",
      "target": "password field",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field contains 'admin'"
    },
    {
      "action_type": "click",
      "target": "Login button",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "User is logged in, main navigation appears"
    },
    {
      "action_type": "click",
      "target": "Users link",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Navigated to Users page (edit_users.php)"
    },
    {
      "action_type": "click",
      "target": "Show / hide columns button",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Column visibility dropdown is opened"
    },
    {
      "action_type": "click",
      "target": "Username column toggle button",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
