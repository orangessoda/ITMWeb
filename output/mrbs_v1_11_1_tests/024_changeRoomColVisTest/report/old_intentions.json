    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"rooms_table_wrapper\"]/div[1]/div[2]/div/button[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Column visibility button clicked, dropdown shown"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"rooms_table_wrapper\"]/div[1]/div[1]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Column visibility toggled"
