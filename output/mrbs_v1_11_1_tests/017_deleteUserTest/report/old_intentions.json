{
  "case_goal": "Delete a user named 'test' from the MRBS system.",
  "summary": "Logs in as admin, navigates to Users page, edits user 'test', then deletes the user by clicking the delete checkbox and overriding the JavaScript confirm dialog.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "",
      "expected_result": "Admin page loaded with login form"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field populated with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login successful, admin navigation panel appears"
    },
    {
      "action_type": "click",
      "target": "/html/body/header/nav/nav[1]/nav[1]/a[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Navigates to edit_users.php page with user table"
    },
    {
      "action_type": "click",
      "target": "/html/body/div[1]/div/div/div[6]/div[3]/div[2]/div/table/tbody/tr[1]/td/form/input[3]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=2&room=1&datatable=1",
      "expected_result": "Edit user form displayed for user 'test'"
    },
    {
      "action_type": "execute_script",
      "target": "//*[@id=\"form_edit_users\"]/fieldset[3]/div/label/input",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://mrbs-old.local:8094/edit_users.php",
      "expected_result": "User 'test' deleted, returns to user list without that user"
    }
  ]
}