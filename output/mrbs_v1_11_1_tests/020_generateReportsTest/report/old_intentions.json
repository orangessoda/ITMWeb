{
  "case_goal": "Verify that the report generation functionality works correctly by logging in, navigating to the report page, setting date range and area filters, and generating a report.",
  "summary": "The test logs into the Meeting Room Booking System as admin, navigates to the Report page, fills in the report form with a date range (2026-05-01 to 2026-07-02) and area filter (test area), then submits the form to generate a report. The final page confirms the report was generated by displaying 'Match area'.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login page is displayed with username and password fields"
    },
    {
      "action_type": "send_keys",
      "target": "username",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field is filled with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "password",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field is filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "Login button",
      "value": "//*[@id=\"logon\"]/fieldset[2]/div/input",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Admin page is displayed with navigation links (Report, Rooms, Users, etc.)"
    },
    {
      "action_type": "click",
      "target": "Report link",
      "value": "/html/body/header/nav/nav[1]/nav[1]/a[2]",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Report page is displayed with form fields for date range and area"
    },
    {
      "action_type": "set_date_range",
      "target": "from_date",
      "value": "2026-05-01",
      "page_url": "http://mrbs-old.local:8094/report.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "From date is set to 2026-05-01"
    },
    {
      "action_type": "set_date_range",
      "target": "to_date",
      "value": "2026-07-02",
      "page_url": "http://mrbs-old.local:8094/report.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "To date is set to 2026-07-02"
    },
    {
      "action_type": "select_area",
      "target": "area select",
      "value": "test area",
      "page_url": "http://mrbs-old.local:8094/report.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Area 'test area' is selected"
    },
    {
      "action_type": "click",
      "target": "Generate report button",
      "value": "//*[@id=\"report_form\"]/fieldset/fieldset[3]/div/input",
      "page_url": "http://mrbs-old.local:8094/report.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Report is generated and 'Match area' text is visible on the page"
    }
  ]
}