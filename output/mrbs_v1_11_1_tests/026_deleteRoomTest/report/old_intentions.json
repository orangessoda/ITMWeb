{
  "case_goal": "Delete a room in MRBS after authentication",
  "summary": "Log in as admin, navigate to Rooms section, delete a specific room (room 1 in area 2), confirm deletion, and verify successful deletion.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login page is displayed with username and password fields"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username entered as admin"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password entered as admin"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login successful, admin page with navigation links displayed"
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/header/nav/nav[1]/nav[1]/a[4]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "Rooms management page displayed with room list"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"rooms_table_wrapper\"]/div[6]/div[3]/div[2]/div/table/tbody/tr/td/div/form/input[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/del.php",
      "expected_result": "Delete confirmation page displayed with YES button"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"del_room_confirm\"]/form[1]/input[6]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php?area=2",
      "expected_result": "Room deleted successfully, area management page shown without the deleted room"
    }
  ]
}