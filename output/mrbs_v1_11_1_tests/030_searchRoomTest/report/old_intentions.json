{
  "case_goal": "Search for a room named 'test room' in the rooms management page.",
  "summary": "Log in as admin, navigate to Rooms page, and search for 'test room' using the table search filter.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "type",
      "target": "//*[@id='username']",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field filled"
    },
    {
      "action_type": "type",
      "target": "//*[@id='password']",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "//*[@id='logon']/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Logged in and admin page shown"
    },
    {
      "action_type": "click",
      "target": "/html/body/header/nav/nav[1]/nav[1]/a[4]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Navigated to Rooms management page"
    },
    {
      "action_type": "clear",
      "target": "//*[@id='rooms_table_filter']/label/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=3&room=2",
      "expected_result": "Search input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='rooms_table_filter']/label/input",
      "value": "test room",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=3&room=2",
      "expected_result": "Search input filled with 'test room'"
    },
    {
      "action_type": "clear",
      "target": "//*[@id='rooms_table_filter']/label/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=3&room=2",
      "expected_result": "Search input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='rooms_table_filter']/label/input",
      "value": "\\ue007",
      "page_url": "http://mrbs-old.local:8094/admin.php?view=day&page_date=2026-05-03&area=3&room=2",
      "expected_result": "Search triggered by Enter key, table filtered to show matching rooms"
    }
  ]
}