{
  "case_goal": "Verify that a user can log in to the MRBS admin panel with valid credentials.",
  "summary": "Log in to MRBS admin page using username 'test' and password 'admin'.",
  "steps": [
    {
      "action_type": "get",
      "target": "http://mrbs-old.local:8094/admin.php",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Login page should be displayed with username and password fields."
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"username\"]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php"
    },
    {
      "action_type": "clear",
      "target": "//*[@id=\"username\"]",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php"
    },
    {
      "action_type": "send_keys",
