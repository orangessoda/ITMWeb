      "page_url": "http://mrbs-old.local:8094/admin.php"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": null,
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "User should be logged in and see links for Rooms, Users, and Log off."
    }
  ]
