{
  "case_goal": "To verify that user information (specifically email addresses) can be copied to clipboard and exported as CSV from the Users management page.",
  "summary": "Logs into MRBS as admin, navigates to the Users list, clicks the 'Copy email addresses' button to copy email data to clipboard, then clicks the 'CSV' button to export the user data as a CSV file.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mrbs-old.local:8094/admin.php",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Admin login page is displayed with username and password fields."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Username field is filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Password field is filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "User is logged in and redirected to admin page with main navigation links."
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/header/nav/nav[1]/nav[1]/a[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "Users page is displayed with a table of users and action buttons."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"users_table_wrapper\"]/div[1]/button[5]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "Email addresses are copied to clipboard (button text 'Copy email addresses')."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"users_table_wrapper\"]/div[1]/button[6]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/edit_users.php?view=day&page_date=2026-05-03&area=3&room=2&datatable=1",
      "expected_result": "CSV file download is initiated (button text 'CSV')."
    }
  ]
}