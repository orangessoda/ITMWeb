{
  "case_goal": "验证帮助页面能够正常访问，并检查FAQ中的锚点导航功能正常。",
  "summary": "测试以admin身份登录后，点击帮助链接进入帮助页面，然后依次点击FAQ中的“How much”和“About”链接，验证页面能够正确跳转到相应锚点。",
  "steps": [
    {
      "action_type": "get",
      "target": "http://mrbs-old.local:8094/admin.php",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "页面成功打开，显示登录表单"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "用户名输入框显示'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "密码输入框显示'admin'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"logon\"]/fieldset[2]/div/input",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "登录成功，页面变为管理界面，显示Rooms、Users等管理链接"
    },
    {
      "action_type": "click",
      "target": "/html/body/header/nav/nav[1]/nav[1]/a[1]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/admin.php",
      "expected_result": "导航到帮助页面，URL变为help.php?view=day&page_date=2026-05-03&area=2&room=1"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"site_faq_contents\"]/ul[4]/li[1]/a",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/help.php?view=day&page_date=2026-05-03&area=2&room=1",
      "expected_result": "页面跳转到FAQ的'How much'锚点，URL变为#how_much"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"site_faq_contents\"]/ul[4]/li[2]/a",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/help.php?view=day&page_date=2026-05-03&area=2&room=1#how_much",
      "expected_result": "页面跳转到FAQ的'About'锚点，URL变为#about"
    }
  ]
}