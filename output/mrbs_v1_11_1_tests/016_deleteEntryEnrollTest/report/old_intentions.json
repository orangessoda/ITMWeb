      "target": "//*[@id=\"registrants\"]/tbody/tr/td[1]/form/input[7]",
      "value": "",
      "page_url": "http://mrbs-old.local:8094/view_entry.php?view=day&year=2026&month=5&day=3&area=2&id=2",
      "expected_result": "Entry deleted and page reloaded"
