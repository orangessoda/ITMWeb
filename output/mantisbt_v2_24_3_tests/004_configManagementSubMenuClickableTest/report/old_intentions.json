{
  "case_goal": "Verify that all submenu items under '配置管理' (Config Management) in the MantisBT admin section are clickable and navigate to the correct configuration pages.",
  "summary": "The test logs into MantisBT as admin (admin/admin), navigates to the management overview page, clicks on the '配置管理' link, then iterates through each submenu item (管理列, 邮件提醒, 工作流过渡, 工作流阀值, 配置报告, 权限报告) by clicking them and confirming the resulting page title/URL.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page opened"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id=\"username\"]",
      "value": null,
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Element located"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"username\"]",
      "value": null,
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Clear succeeded"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Typing succeeded"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": null,
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Element located"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
