{
  "case_goal": "Edit an existing project category in MantisBT",
  "summary": "Login as admin, navigate to project management, edit the first category by changing name to '123' and updating assigned user, then submit.",
  "steps": [
    {
      "action_type": "get",
      "target": "",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page loaded"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username entered"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Navigate to password page"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password entered"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/my_view_page.php",
      "expected_result": "Logged in, navigate to My View page"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"sidebar\"]/ul/li[7]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Navigate to management overview"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"main-container\"]/div[2]/div[2]/div/ul/li[3]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_page.php",
      "expected_result": "Navigate to project management"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"categories\"]/div/div[2]/div/div/table/tbody/tr[1]/td[3]/div/div[1]/form/fieldset/button",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_cat_edit_page.php?id=1&project_id=0",
      "expected_result": "Navigate to category edit page"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"proj-category-name\"]",
      "value": "123",
      "page_url": "http://mantis-old.local:8080/manage_proj_cat_edit_page.php?id=1&project_id=0",
      "expected_result": "Category name changed to '123'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"proj-category-assigned-to\"]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_cat_edit_page.php?id=1&project_id=0",
      "expected_result": "Assigned-to dropdown opened"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"proj-category-assigned-to\"]/option[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_cat_edit_page.php?id=1&project_id=0",
      "expected_result": "Second option selected as new assignee"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"manage-proj-category-update-form\"]/div/div[3]/input",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_cat_update.php",
      "expected_result": "Category updated and redirected to confirmation page"
    }
  ]
}