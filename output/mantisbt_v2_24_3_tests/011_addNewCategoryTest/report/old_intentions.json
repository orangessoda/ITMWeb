{
  "case_goal": "Add a new category 'test' in MantisBT global categories.",
  "summary": "Login as admin, navigate to Manage > Project Management, and add a new category named 'test'.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page is displayed with username field."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field is cleared and filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Navigated to password page; hidden username shows 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field is cleared and filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/my_view_page.php",
      "expected_result": "Logged in successfully; 'My View' page is displayed."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[7]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Manage overview page is displayed with 'Project Management' link."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/ul/li[3]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_page.php",
      "expected_result": "Project Management page is displayed with 'Add Category' form."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"categories\"]/div/div[2]/form/div/input[3]",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_proj_page.php",
      "expected_result": "Category name input is cleared and filled with 'test'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"categories\"]/div/div[2]/form/div/input[4]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_page.php",
      "expected_result": "New category 'test' is added; edit/delete buttons appear for it."
    }
  ]
}