{
  "case_goal": "Test applying account management filters (hide inactive, show disabled, search) in MantisBT user management.",
  "summary": "Log in as admin, navigate to User Management page, set filter options to hide inactive users and show disabled users, enter search term 'test', and apply the filter.",
  "steps": [
    {
      "action_type": "open",
      "target": "login page",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "type",
      "target": "username input",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field filled"
    },
    {
      "action_type": "click",
      "target": "login button (username submit)",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Redirect to password page"
    },
    {
      "action_type": "type",
      "target": "password input",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "login button (password submit)",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "Login successful, redirected to project create page"
    },
    {
      "action_type": "click",
      "target": "管理 (Management) link",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Navigate to Management overview page"
    },
    {
      "action_type": "click",
      "target": "用户管理 (User Management) link",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Navigate to User Management page"
    },
    {
      "action_type": "click",
      "target": "Hide inactive checkbox (label[1]/span)",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Checkbox toggled (hide inactive enabled)"
    },
    {
      "action_type": "click",
      "target": "Show disabled checkbox (label[2]/span)",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Checkbox toggled (show disabled enabled)"
    },
    {
      "action_type": "type",
      "target": "search input",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Search field filled with 'test'"
    },
    {
      "action_type": "click",
      "target": "Apply filter button (input[7])",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Filter applied: alphabet links show hideinactive=1, showdisabled=1, search=test"
    }
  ]
}