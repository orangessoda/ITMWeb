{
  "case_goal": "Search for user accounts by username and email in MantisBT user management.",
  "summary": "Login as admin, navigate to user management, filter by letter 'T', search for 'test', then search for 'root@localhost'.",
  "steps": [
    {
      "action_type": "get",
      "target": "",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page displayed with username field"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password page displayed"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "Redirected to manage project create page"
    },
    {
      "action_type": "click",
      "target": "link text=管理",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Management overview page displayed"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/ul/li[2]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "User management page displayed"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/div/div[2]/div/div/a[21]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php?sort=username&dir=ASC&save=1&hideinactive=0&showdisabled=0&filter=T&search=",
      "expected_result": "Filter by letter T applied"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"search\"]",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Search field filled with 'test'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"manage-user-filter\"]/fieldset/input[7]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Search executed, results shown"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/div/div[2]/div/div/a[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php?sort=username&dir=ASC&save=1&hideinactive=0&showdisabled=0&filter=A&search=test",
      "expected_result": "Filter changed to A with search 'test'"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"search\"]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Search field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"search\"]",
      "value": "root@localhost",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Search field filled with 'root@localhost'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"manage-user-filter\"]/fieldset/input[7]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_user_page.php",
      "expected_result": "Search executed, results for email shown"
    }
  ]
}