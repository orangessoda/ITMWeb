{
  "case_goal": "Verify that a user can successfully log in with valid credentials (admin/admin).",
  "summary": "Navigate to login page, enter username 'admin', click login, enter password 'admin', click login, expect redirect to project creation page.",
  "steps": [
    {
      "action_type": "get",
      "target": "http://mantis-old.local:8080/login_page.php",
      "value": "",
      "page_url": "",
      "expected_result": "Login page loads with username field and login button."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='username']",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field contains 'admin'."
    },
    {
      "action_type": "click",
      "target": "//*[@id='login-form']/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Redirect to password page (login_password_page.php)."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='password']",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field contains 'admin'."
    },
    {
      "action_type": "click",
      "target": "//*[@id='login-form']/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Successful login, redirect to manage_proj_create_page.php."
    }
  ]
}