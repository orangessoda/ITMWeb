{
  "case_goal": "验证管理员能够编辑标签的名称和描述。",
  "summary": "登录管理员账户，通过管理界面导航到标签管理，选择现有标签'test'，将其名称和描述更新为'123'，并确认更新成功。",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "页面标题为'MantisBT'"
    },
    {
      "action_type": "type",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "用户名输入成功"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "跳转到密码登录页面，标题'MantisBT'"
    },
    {
      "action_type": "type",
      "target": "//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "密码输入成功"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "登录成功，页面标题为'我的视图 - MantisBT'"
    },
    {
      "action_type": "click",
      "target": "link text=管理",
      "value": "",
      "page_url": "http://mantis-old.local:8080/my_view_page.php",
      "expected_result": "进入管理页面，标题'管理 - MantisBT'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"main-container\"]/div[2]/div[2]/div/ul/li[4]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "进入标签管理页面，标题'标签管理 - MantisBT'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"main-container\"]/div[2]/div[2]/div/div/div[4]/div[2]/div[2]/div/table/tbody/tr/td[1]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_tags_page.php",
      "expected_result": "选择标签test，进入详情页，标题'标签详情: test - MantisBT'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"main-container\"]/div[2]/div[2]/div/div/div[2]/div[2]/div/div[3]/form[1]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/tag_view_page.php?tag_id=1",
      "expected_result": "进入更新标签页面，标题'更新标签: test - MantisBT'"
    },
    {
      "action_type": "type",
      "target": "//*[@id=\"tag-name\"]",
      "value": "123",
      "page_url": "http://mantis-old.local:8080/tag_update_page.php",
      "expected_result": "标签名称更新为'123'"
    },
    {
      "action_type": "type",
      "target": "//*[@id=\"tag-description\"]",
      "value": "123",
      "page_url": "http://mantis-old.local:8080/tag_update_page.php",
      "expected_result": "标签描述更新为'123'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"main-container\"]/div[2]/div[2]/div/div/form/div/div[3]/input",
      "value": "",
      "page_url": "http://mantis-old.local:8080/tag_update_page.php",
      "expected_result": "更新成功，返回标签详情页，标题'标签详情: 123 - MantisBT'"
    }
  ]
}