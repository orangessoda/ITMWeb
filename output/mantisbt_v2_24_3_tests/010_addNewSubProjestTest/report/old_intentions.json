{
  "case_goal": "Add a new subproject named 'test' under the existing project 'testProgram'.",
  "summary": "Login as admin, navigate to Manage > Project Management, select 'testProgram' project, click 'New Subproject', fill in name and description as 'test', and submit.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page is loaded"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field cleared and 'admin' entered"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Navigate to password page"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field cleared and 'admin' entered"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Login successful, my view page displayed"
    },
    {
      "action_type": "click",
      "target": "link text=管理",
      "value": "",
      "page_url": "http://mantis-old.local:8080/my_view_page.php",
      "expected_result": "Navigate to management overview page"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/ul/li[3]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Navigate to project management page"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/div/div[2]/div[2]/div/div[2]/table/tbody/tr/td[1]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_page.php",
      "expected_result": "Navigate to project edit page for 'testProgram'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"manage-project-update-subprojects-div\"]/div/div[2]/form/fieldset/button",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_edit_page.php?project_id=1",
      "expected_result": "Navigate to create subproject page with parent_id=1"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"project-name\"]",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php?parent_id=1",
      "expected_result": "Project name field cleared and 'test' entered"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"project-description\"]",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php?parent_id=1",
      "expected_result": "Description field cleared and 'test' entered"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"manage-project-create-form\"]/div/div[3]/input",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php?parent_id=1",
      "expected_result": "Subproject 'test' created, redirected to manage_proj_create.php"
    }
  ]
}