{
  "case_goal": "Verify that each menu item in the sidebar navigation is clickable and navigates to the expected page after logging in as admin.",
  "summary": "Login with admin/admin and click through all six menu items in the sidebar: 我的视图, 查看问题, 变更日志, 路线图, 摘要, and 管理 to confirm they are clickable and direct to the correct pages.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "MantisBT"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Text entered"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "MantisBT"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Text entered"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "MantisBT"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[1]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/my_view_page.php",
      "expected_result": "我的视图 - MantisBT"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[2]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/view_all_bug_page.php",
      "expected_result": "查看问题 - MantisBT"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[3]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/changelog_page.php",
      "expected_result": "变更日志 - MantisBT"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[4]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/roadmap_page.php",
      "expected_result": "路线图 - MantisBT"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[5]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/summary_page.php",
      "expected_result": "摘要 - MantisBT"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sidebar\"]/ul/li[6]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "管理 - MantisBT"
    }
  ]
}