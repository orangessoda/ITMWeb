{
  "case_goal": "Verify that an administrator can create a new custom field in MantisBT.",
  "summary": "Log in as admin, navigate to custom field management, and create a custom field named 'test'.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "login page",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page is displayed with username field and login button."
    },
    {
      "action_type": "clear",
      "target": "username field",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field is cleared."
    },
    {
      "action_type": "type",
      "target": "username field",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field contains 'admin'."
    },
    {
      "action_type": "click",
      "target": "login button",
      "value": "//*[@id='login-form']/fieldset/input[2]",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Navigates to password page (login_password_page.php)."
    },
    {
      "action_type": "clear",
      "target": "password field",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field is cleared."
    },
    {
      "action_type": "type",
      "target": "password field",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field contains 'admin'."
    },
    {
      "action_type": "click",
      "target": "login button",
      "value": "//*[@id='login-form']/fieldset/input[3]",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Logged in successfully and navigates to '我的视图' (my view page)."
    },
    {
      "action_type": "click",
      "target": "管理 link",
      "value": "管理",
      "page_url": "http://mantis-old.local:8080/my_view_page.php",
      "expected_result": "Navigates to management overview page (manage_overview_page.php) with links to various management sections."
    },
    {
      "action_type": "click",
      "target": "自定义字段管理 link",
      "value": "//*[@id='main-container']/div[2]/div[2]/div/ul/li[5]/a",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Navigates to custom field management page (manage_custom_field_page.php) with a text input for new field name and a '新建自定义字段' button."
    },
    {
      "action_type": "clear",
      "target": "new custom field name input",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_custom_field_page.php",
      "expected_result": "The name input field is cleared."
    },
    {
      "action_type": "type",
      "target": "new custom field name input",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_custom_field_page.php",
      "expected_result": "The name input field contains 'test'."
    },
    {
      "action_type": "click",
      "target": "新建自定义字段 button",
      "value": "//*[@id='main-container']/div[2]/div[2]/div/div/div[2]/div[2]/div[2]/form/fieldset/input[3]",
      "page_url": "http://mantis-old.local:8080/manage_custom_field_page.php",
      "expected_result": "Navigates to custom field create/edit page (manage_custom_field_create.php) confirming the new field 'test' has been created."
    }
  ]
}