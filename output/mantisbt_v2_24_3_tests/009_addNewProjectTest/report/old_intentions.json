{
  "case_goal": "Add a new project in MantisBT",
  "summary": "Log in with admin credentials, navigate to project management, create a new project named 'testProgram' with description 'test', and submit.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "url",
      "value": "http://mantis-old.local:8080/login_page.php",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Login page loaded with username field"
    },
    {
      "action_type": "type",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_page.php",
      "expected_result": "Username field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[2]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Navigated to password entry page"
    },
    {
      "action_type": "type",
      "target": "xpath=//*[@id=\"password\"]",
      "value": "admin",
      "page_url": "http://mantis-old.local:8080/login_password_page.php",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"login-form\"]/fieldset/input[3]",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "Login completed, redirected to project creation page"
    },
    {
      "action_type": "click",
      "target": "link text=管理",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_overview_page.php",
      "expected_result": "Navigated to management overview page with title '管理 - MantisBT'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/ul/li[3]/a",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_page.php",
      "expected_result": "Navigated to project management page with '创建新项目' button"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"main-container\"]/div[2]/div[2]/div/div/div[2]/div[2]/div/div[1]/form/fieldset/button",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "Project creation form loaded with fields for name, status, description"
    },
    {
      "action_type": "type",
      "target": "xpath=//*[@id=\"project-name\"]",
      "value": "testProgram",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "Project name field filled with 'testProgram'"
    },
    {
      "action_type": "type",
      "target": "xpath=//*[@id=\"project-description\"]",
      "value": "test",
      "page_url": "http://mantis-old.local:8080/manage_proj_create_page.php",
      "expected_result": "Description field filled with 'test'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"manage-project-create-form\"]/div/div[3]/input",
      "value": "",
      "page_url": "http://mantis-old.local:8080/manage_proj_create.php",
      "expected_result": "Project created and confirmation page loaded with link to 'testProgram'"
    }
  ]
}