{
  "case_goal": "Create a new database named 'test' in phpMyAdmin",
  "summary": "Log in to phpMyAdmin, navigate to create database page, enter database name 'test', and confirm creation, then verify the database appears in the navigation tree.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://phpmyadmin-old.local:8092/",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Login page loads"
    },
    {
      "action_type": "clear",
      "target": "id",
      "value": "input_username",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username field emptied"
    },
    {
      "action_type": "send_keys",
      "target": "id",
      "value": "input_username",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username 'admin' entered"
    },
    {
      "action_type": "clear",
      "target": "id",
      "value": "input_password",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password field emptied"
    },
    {
      "action_type": "send_keys",
      "target": "id",
      "value": "input_password",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password 'admin' entered"
    },
    {
      "action_type": "click",
      "target": "id",
      "value": "input_go",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Login button clicked, navigate to main dashboard"
    },
    {
      "action_type": "click",
      "target": "link text",
      "value": "新建",
      "page_url": "http://phpmyadmin-old.local:8092/server_databases.php?server=1",
      "expected_result": "Create database form displayed"
    },
    {
      "action_type": "clear",
      "target": "id",
      "value": "text_create_db",
      "page_url": "http://phpmyadmin-old.local:8092/server_databases.php?server=1",
      "expected_result": "Database name field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id",
      "value": "text_create_db",
      "page_url": "http://phpmyadmin-old.local:8092/server_databases.php?server=1",
      "expected_result": "Database name 'test' entered"
    },
    {
      "action_type": "click",
      "target": "id",
      "value": "buttonGo",
      "page_url": "http://phpmyadmin-old.local:8092/server_databases.php?server=1",
      "expected_result": "Database creation submitted, success message appears and database 'test' appears in navigation"
    },
    {
      "action_type": "find_element",
      "target": "xpath",
      "value": "//*[@id=\"pma_navigation_tree_content\"]//a[normalize-space()=\"test\"]",
      "page_url": "http://phpmyadmin-old.local:8092/server_databases.php?server=1",
      "expected_result": "Database 'test' located in navigation tree"
    }
  ]
}