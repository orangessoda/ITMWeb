{
  "case_goal": "Export a MySQL user account using phpMyAdmin after logging in as admin.",
  "summary": "Logs into phpMyAdmin, navigates to user accounts page, selects an account, and initiates export by clicking the first button in a dialog.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://phpmyadmin-old.local:8092/",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Login page is displayed with username, password fields and submit button."
    },
    {
      "action_type": "find_element",
      "target": "id=input_username",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username input element is located."
    },
    {
      "action_type": "clear",
      "target": "id=input_username",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username field is cleared."
    },
    {
      "action_type": "find_element",
      "target": "id=input_username",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username input element is located again."
    },
    {
      "action_type": "send_keys",
      "target": "id=input_username",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Text 'admin' is typed into username field."
    },
    {
      "action_type": "find_element",
      "target": "id=input_password",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password input element is located."
    },
    {
      "action_type": "clear",
      "target": "id=input_password",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password field is cleared."
    },
    {
      "action_type": "find_element",
      "target": "id=input_password",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password input element is located again."
    },
    {
      "action_type": "send_keys",
      "target": "id=input_password",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Text 'admin' is typed into password field."
    },
    {
      "action_type": "find_element",
      "target": "id=input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Submit button is located."
    },
    {
      "action_type": "click",
      "target": "id=input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "User is logged in and main phpMyAdmin interface is displayed."
    },
    {
      "action_type": "find_element",
      "target": "link text=账户",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "Link with text '账户' (Accounts) is located."
    },
    {
      "action_type": "click",
      "target": "link text=账户",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "User is navigated to user accounts management page (server_privileges.php)."
    },
    {
      "action_type": "find_element",
      "target": "name=submit_mult",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "Element with name 'submit_mult' is located."
    },
    {
      "action_type": "click",
      "target": "name=submit_mult",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "A multi-submit action (possibly export) is triggered."
    },
    {
      "action_type": "find_element",
      "target": "css selector=.ui-button:nth-child(1)",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "First button in a UI dialog is located."
    },
    {
      "action_type": "click",
      "target": "css selector=.ui-button:nth-child(1)",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "Export dialog is confirmed or export process is initiated."
    }
  ]
}