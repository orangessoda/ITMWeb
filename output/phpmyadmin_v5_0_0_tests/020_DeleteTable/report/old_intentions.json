{
  "case_goal": "Delete the 'newtestable' table from the 'test' database.",
  "summary": "The test logs into phpMyAdmin, navigates to the 'test' database, then deletes the 'newtestable' table via the operations page.",
  "steps": [
    {
      "action_type": "execute_script",
      "target": "document.body.style.zoom='80%'",
      "value": "",
      "page_url": "chrome://new-tab-page/",
      "expected_result": "Zoom set"
    },
    {
      "action_type": "get",
      "target": "url",
      "value": "http://phpmyadmin-old.local:8092/",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Page loaded"
    },
    {
      "action_type": "clear",
      "target": "input_username",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "input_username",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username entered"
    },
    {
      "action_type": "clear",
      "target": "input_password",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "input_password",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password entered"
    },
    {
      "action_type": "click",
      "target": "input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "Login successful, main page shown"
    },
    {
      "action_type": "click",
      "target": "test (link text)",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/db_structure.php?server=1&db=test",
      "expected_result": "Database structure page shown"
    },
    {
      "action_type": "send_keys",
      "target": "html (tag name)",
      "value": "\\ue010",
      "page_url": "http://phpmyadmin-old.local:8092/tbl_operations.php?db=test&table=newtestable",
      "expected_result": "Escape sent (possible dialog dismissal)"
    },
    {
      "action_type": "click",
      "target": "drop_tbl_anchor",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/tbl_operations.php?db=test&table=newtestable",
      "expected_result": "Drop table dialog triggered"
    },
    {
      "action_type": "click",
      "target": ".submitOK (CSS selector)",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/tbl_operations.php?db=test&table=newtestable",
      "expected_result": "Table deleted successfully, page shows confirmation"
    }
  ]
}