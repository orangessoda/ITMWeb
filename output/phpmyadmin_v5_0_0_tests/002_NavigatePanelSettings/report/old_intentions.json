{
  "case_goal": "Navigate to the Navigation Panel Settings in phpMyAdmin and modify the maximum navigation items setting.",
  "summary": "Login to phpMyAdmin, open navigation settings, select 'Navigation Tree' tab, set MaxNavigationItems to 50, and apply.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://phpmyadmin-old.local:8092/",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Page opened with phpMyAdmin login screen"
    },
    {
      "action_type": "send_keys",
      "target": "id=input_username",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username field filled with admin"
    },
    {
      "action_type": "send_keys",
      "target": "id=input_password",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password field filled with admin"
    },
    {
      "action_type": "click",
      "target": "id=input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "Login succeeds, page loads"
    },
    {
      "action_type": "click",
      "target": "css selector=#pma_navigation_settings_icon > .icon",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php#",
      "expected_result": "Opens navigation settings dialog"
    },
    {
      "action_type": "click",
      "target": "link text=导航树",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php#tab_Navi_tree",
      "expected_result": "Navigation Tree tab selected"
    },
    {
      "action_type": "send_keys",
      "target": "id=MaxNavigationItems",
      "value": "50",
      "page_url": "http://phpmyadmin-old.local:8092/index.php#tab_Navi_tree",
      "expected_result": "Field set to 50"
    },
    {
      "action_type": "click",
      "target": "css selector=.ui-dialog-buttonset > button:nth-child(1)",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php#tab_Navi_tree",
      "expected_result": "Settings saved and dialog closed"
    }
  ]
}