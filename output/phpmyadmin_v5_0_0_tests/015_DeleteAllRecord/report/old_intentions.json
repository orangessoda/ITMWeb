{
  "case_goal": "Delete all records from table 'testtable' in database 'test' via phpMyAdmin interface",
  "summary": "Log in to phpMyAdmin with admin credentials, navigate to the 'test' database, select the 'testtable' table, click the 'Empty' (delete all records) button, confirm the deletion, and verify the success message.",
  "steps": [
    {
      "action_type": "execute_script",
      "target": "document.body.style.zoom='80%'",
      "value": "80%",
      "page_url": "chrome://new-tab-page/",
      "expected_result": "Zoom set to 80% on the page"
    },
    {
      "action_type": "get",
      "target": "http://phpmyadmin-old.local:8092/",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "phpMyAdmin login page loaded"
    },
    {
      "action_type": "clear",
      "target": "id=input_username",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=input_username",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username 'admin' entered"
    },
    {
      "action_type": "clear",
      "target": "id=input_password",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=input_password",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password 'admin' entered"
    },
    {
      "action_type": "click",
      "target": "id=input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Login submitted, main panel with database list displayed"
    },
    {
      "action_type": "click",
      "target": "link text=test",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "Database 'test' structure page loaded"
    },
    {
      "action_type": "click",
      "target": "css selector=.btn:nth-child(7) > .nowrap",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/db_structure.php?server=1&db=test",
      "expected_result": "Table 'testtable' browsing page with delete option"
    },
    {
      "action_type": "click",
      "target": "id=buttonYes",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/sql.php?server=1&db=test&table=testtable&pos=0",
      "expected_result": "Confirmation dialog accepted, deletion executed"
    },
    {
      "action_type": "find_element",
      "target": "css selector=.success",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/sql.php?server=1&db=test&table=testtable&pos=0",
      "expected_result": "Success message appears indicating all records deleted"
    }
  ]
}