{
  "case_goal": "Delete a record from testtable in the test database using phpMyAdmin and verify deletion.",
  "summary": "Navigate to phpMyAdmin, login with admin/admin, select test database, browse testtable, delete the first row, confirm deletion, then check the first row remains.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://phpmyadmin-old.local:8092/",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "send_keys",
      "target": "input_username",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username field filled"
    },
    {
      "action_type": "send_keys",
      "target": "input_password",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Redirect to main interface"
    },
    {
      "action_type": "click",
      "target": "link text=test",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "Database structure page for test"
    },
    {
      "action_type": "click",
      "target": "link text=testtable",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/db_structure.php?server=1&db=test",
      "expected_result": "Table browse page for testtable"
    },
    {
      "action_type": "click",
      "target": "tr:nth-child(1) .delete_row > .nowrap",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/sql.php?server=1&db=test&table=testtable&pos=0",
      "expected_result": "Delete confirmation dialog appears"
    },
    {
      "action_type": "click",
      "target": ".submitOK",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/sql.php?server=1&db=test&table=testtable&pos=0",
      "expected_result": "Record deleted, page reloads"
    },
    {
      "action_type": "find_element",
      "target": "tr:nth-child(1) > .nowrap",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/sql.php?server=1&db=test&table=testtable&pos=0",
      "expected_result": "First row content visible after deletion"
    }
  ]
}