{
  "case_goal": "Delete a user account (admin) via phpMyAdmin user management interface.",
  "summary": "Log in to phpMyAdmin as admin, navigate to User Accounts page, execute deletion by clicking 'Go' button and confirming with 'OK', then verify the result.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://phpmyadmin-old.local:8092/",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Login page is displayed with title 'phpMyAdmin'"
    },
    {
      "action_type": "send_keys",
      "target": "input_username",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Username field populated with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "input_password",
      "value": "admin",
      "page_url": "http://phpmyadmin-old.local:8092/",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "click",
      "target": "input_go",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/index.php",
      "expected_result": "Main page displayed with navigation panel and database list"
    },
    {
      "action_type": "click",
      "target": "账户",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "User accounts page displayed"
    },
    {
      "action_type": "click",
      "target": "buttonGo",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "Deletion process initiated (page reloads with same URL)"
    },
    {
      "action_type": "click",
      "target": ".submitOK",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "Deletion confirmed, page remains on server_privileges.php"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id='usersForm']/div[1]",
      "value": "",
      "page_url": "http://phpmyadmin-old.local:8092/server_privileges.php?viewing_mode=server",
      "expected_result": "Verification element exists (success message or updated form)"
    }
  ]
}