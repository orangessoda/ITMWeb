{
  "case_goal": "Delete a time track entry from a project in Collabtive.",
  "summary": "Login as admin, navigate to project 'test', open timetracker, and delete the first time track entry by simulating a confirm dialog.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "clear",
      "target": "username",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "username",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field populated with 'admin'"
    },
    {
      "action_type": "clear",
      "target": "password",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "password",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "click",
      "target": "login form div (focus)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login form remains, fields retain values"
    },
    {
      "action_type": "click",
      "target": "login button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Redirected to Desktop page (index.php?mode=login)"
    },
    {
      "action_type": "click",
      "target": "project link (first row)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Project 'test' page shown (title: 'Project test @ Collabtive')"
    },
    {
      "action_type": "click",
      "target": "timetracker tab (li[7] a)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Timetracker page displayed (title: 'Timetracker @ Collabtive')"
    },
    {
      "action_type": "execute_script",
      "target": "delete link for first track entry",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://collabtive-old.local:8084/managetimetracker.php?action=showproject&id=1",
      "expected_result": "First time track entry deleted (page remains on timetracker, entry removed)"
    }
  ]
}