{
  "case_goal": "Delete a task list from a project in Collabtive.",
  "summary": "Logs in as admin, navigates to the first project, opens the Tasks tab, and deletes the task list by clicking the delete icon and accepting the confirmation dialog.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page loaded"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field populated with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"pass\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"loginform\"]/fieldset/div[3]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Stay logged in checkbox toggled (no URL change)"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Redirected to Desktop page (index.php?mode=login)"
    },
    {
      "action_type": "click",
      "target": "/html/body/div[1]/div[2]/div[2]/div/div[4]/div/div[2]/div[2]/table/tbody/tr[1]/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Project page for 'test' loaded (manageproject.php?action=showproject&id=1)"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"contentwrapper\"]/div[1]/ul/li[3]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Tasks page loaded (managetask.php?action=showproject&id=1)"
    },
    {
      "action_type": "execute_script",
      "target": "//*[@id=\"blockTasks\"]/div[3]/div/a[2]",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Task list deleted, page shows mode=listdeleted"
    }
  ]
}