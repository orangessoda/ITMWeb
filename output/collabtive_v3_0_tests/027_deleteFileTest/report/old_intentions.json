      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Hover triggers reveal of delete button for the file"
    },
    {
      "action_type": "execute_script",
      "target": "delete button (xpath=/html/body/div[1]/div[2]/div[2]/div/div/div[3]/div[3]/div[2]/div/div/ul/li[2]/div/table/tbody/tr[1]/td[3]/div/a) with confirm override",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "File deletion triggered; file 'aTestImg_4...' removed from the list and page remains on Files page"
    }
