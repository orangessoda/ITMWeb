    {
      "action_type": "click",
      "target": "Files tab (xpath=//*[@id=\"contentwrapper\"]/div[1]/ul/li[5]/a)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Files page with title 'Files @ Collabtive' displayed, showing file listing"
