{
  "case_goal": "Delete a file folder from a project in Collabtive.",
  "summary": "Login as admin, navigate to project 'test', access Files tab, hover over 'testfolder', and delete it using JavaScript to skip confirmation dialog.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login @ Collabtive page displayed"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field populated"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"pass\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field populated"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Desktop @ Collabtive page displayed"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"proj_1\"]/tr[1]/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project test @ Collabtive page displayed"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"contentwrapper\"]/div[1]/ul/li[5]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Files @ Collabtive page displayed"
    },
    {
      "action_type": "hover",
      "target": "/html/body/div[1]/div[2]/div[2]/div/div/div[3]/div[3]/div[2]/div/div/ul/li/div",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Delete link becomes visible on hover"
    },
    {
      "action_type": "execute_script",
      "target": "/html/body/div[1]/div[2]/div[2]/div/div/div[3]/div[3]/div[2]/div/div/ul/li/div/table/tbody/tr[1]/td[3]/div/a",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Folder 'testfolder' deleted from files list"
    }
  ]
}