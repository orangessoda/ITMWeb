{
  "case_goal": "To test adding a new user role with specific permissions in Collabtive.",
  "summary": "Admin logs in, navigates to User Administration, opens the role form, fills in role name 'test', enables several permissions, and submits.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "Login page",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page is displayed"
    },
    {
      "action_type": "type",
      "target": "username input",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field filled"
    },
    {
      "action_type": "type",
      "target": "password input",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "Login button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Redirect to Desktop page"
    },
    {
      "action_type": "navigate",
      "target": "Admin -> Project Administration",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=projects",
      "expected_result": "Project Administration page displayed"
    },
    {
      "action_type": "navigate",
      "target": "User Administration tab",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "User Administration page displayed"
    },
    {
      "action_type": "click",
      "target": "Add Role button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "Role form expanded"
    },
    {
      "action_type": "type",
      "target": "Role name input",
      "value": "test",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "Role name entered"
    },
    {
      "action_type": "click",
      "target": "Permission checkboxes",
      "value": "permissions_projects[add], permissions_projects[edit], permissions_milestones[view], permissions_milestones[add], permissions_milestones[edit], permissions_tasks[view], permissions_tasks[add], permissions_tasks[edit], permissions_messages[view], permissions_messages[add], permissions_messages[edit], permissions_files[view], permissions_files[add]",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "Selected permissions are checked"
    },
    {
      "action_type": "click",
      "target": "Add button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "Role is added (page may refresh)"
    }
  ]
}