    {
      "action_type": "find_element",
      "target": "//*[@id=\"sprojectTree5\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Messages tree element (message link)"
