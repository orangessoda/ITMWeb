{
  "case_goal": "Edit an existing message in a Collabtive project",
  "summary": "Log in, open project 'test', navigate to messages, open message 'testMsg', click edit, clear and type new text in the body editor, save the edit.",
  "steps": [
    {
      "action_type": "get",
      "target": "url=http://collabtive-old.local:8084/",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page with username, password fields and Login button"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username input field visible"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field cleared"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username input field visible"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field populated with 'admin'"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"pass\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password input field visible"
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id=\"pass\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field cleared"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"pass\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password input field visible"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"pass\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"loginform\"]/fieldset/div[3]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login form stay logged in checkbox area"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"loginform\"]/fieldset/div[3]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Focus on login form (page remains login)"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login button visible"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Desktop page with project list"
    },
    {
      "action_type": "find_element",
      "target": "/html/body/div[1]/div[2]/div[2]/div/div[4]/div/div[2]/div[2]/table/tbody/tr[1]/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Project 'test' link visible"
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/div[1]/div[2]/div[2]/div/div[4]/div/div[2]/div[2]/table/tbody/tr[1]/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project 'test' overview page with project tabs"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"openall\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
