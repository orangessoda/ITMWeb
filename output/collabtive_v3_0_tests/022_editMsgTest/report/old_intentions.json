    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"sprojectTree5\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Message page with title 'testMsg' and edit/reply buttons"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"edit_butn\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Edit button visible"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"edit_butn\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Edit form appears with title input and rich text editor"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id=\"msgtext_ifr\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "IFrame of message text editor"
    },
    {
      "action_type": "switch_frame",
      "target": "xpath=//*[@id=\"msgtext_ifr\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
