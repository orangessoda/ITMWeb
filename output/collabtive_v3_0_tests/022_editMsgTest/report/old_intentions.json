    },
    {
      "action_type": "find_element",
      "target": "/html/body",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Editor body element"
    },
    {
      "action_type": "clear",
      "target": "xpath=/html/body",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Editor body cleared"
    },
    {
      "action_type": "find_element",
      "target": "/html/body",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Editor body element"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=/html/body",
      "value": "test",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Editor body contains 'test'"
    },
    {
      "action_type": "find_element",
      "target": "/html/body/div[1]/div[2]/div[2]/div/div/div[4]/div[2]/form/fieldset/div[3]/button[1]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Save button in edit form"
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/div[1]/div[2]/div[2]/div/div/div[4]/div[2]/form/fieldset/div[3]/button[1]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showproject&id=1&mode=edited",
      "expected_result": "Messages list page with confirmation 'mode=edited'"
    }
  ]
}