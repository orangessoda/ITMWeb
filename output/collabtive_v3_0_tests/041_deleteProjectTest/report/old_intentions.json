{
  "case_goal": "Delete a project from the Collabtive project list",
  "summary": "Login with admin credentials, then delete the first project by clicking its delete link and overriding the confirmation dialog.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page is displayed"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field populated with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"pass\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "User is logged in and redirected to Desktop page"
    },
    {
      "action_type": "execute_script",
      "target": "//*[@id=\"proj_1\"]/tr[1]/td[5]/a[2]",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Project deletion is confirmed and the project is removed from the list"
    }
  ]
}