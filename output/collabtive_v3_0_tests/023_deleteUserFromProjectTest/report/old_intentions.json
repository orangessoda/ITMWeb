{
  "case_goal": "Withdraw a user from a project",
  "summary": "Log in as admin, navigate to project 'test', open People tab, hover over admin user to reveal deassign option, click deassign, select user 'test' as new assignee, and click Save to remove admin from project.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page loaded with username/password fields"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field filled with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"pass\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"loginform\"]/fieldset/div[3]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Stay logged in area clicked (no page change)"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login submitted, redirected to Desktop page"
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/div[1]/div[2]/div[2]/div/div[4]/div/div[2]/div[2]/table/tbody/tr[1]/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Navigated to project test overview"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"contentwrapper\"]/div[1]/ul/li[6]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Navigated to People tab showing project members"
    },
    {
      "action_type": "hover",
      "target": "xpath=//*[@id=\"iw_1\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageuser.php?action=showproject&id=1",
      "expected_result": "Admin user's action links (deassign, edit) become visible"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"iw_1\"]/table/tbody/tr[1]/td[3]/div/a[1]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageuser.php?action=showproject&id=1",
      "expected_result": "Withdraw User form displayed with reassign dropdown and Save button"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"assignto\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=deassignform&id=1&user=1",
      "expected_result": "Dropdown opens showing available users to assign tasks to"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"assignto\"]/option[2]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=deassignform&id=1&user=1",
      "expected_result": "Second option (test user) selected"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"content-left-in\"]/div/div[1]/h2[2]/form/fieldset/div[3]/button[1]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=deassignform&id=1&user=1",
      "expected_result": "Form submitted, admin removed from project, redirected to People page with mode=deassigned"
    }
  ]
}