{
  "case_goal": "Add a new folder named 'test folder' to the project 'test' in Collabtive, ensuring successful folder creation under the Files section.",
  "summary": "Logs into Collabtive as admin, navigates to the 'test' project, accesses the Files tab, opens the Add Folder form, enters 'test folder' as the folder name, and submits to create the folder.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login @ Collabtive page is displayed"
    },
    {
      "action_type": "type",
      "target": "username",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field filled with 'admin'"
    },
    {
      "action_type": "type",
      "target": "password",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "Login button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Successful login; Desktop @ Collabtive page displayed"
    },
    {
      "action_type": "click",
      "target": "First project link (test)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project 'test' page displayed with project details"
    },
    {
      "action_type": "click",
      "target": "Files tab",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Files @ Collabtive page displayed with file management options"
    },
    {
      "action_type": "click",
      "target": "Add Folder button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Add Folder form becomes visible with folder title input"
    },
    {
      "action_type": "type",
      "target": "Folder title input",
      "value": "test folder",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1",
      "expected_result": "Folder title field filled with 'test folder'"
    },
    {
      "action_type": "click",
      "target": "Add button (submit folder form)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managefile.php?action=showproject&id=1&mode=folderadded",
      "expected_result": "Folder 'test folder' is added successfully; URL parameter 'mode=folderadded' confirms creation"
    }
  ]
}