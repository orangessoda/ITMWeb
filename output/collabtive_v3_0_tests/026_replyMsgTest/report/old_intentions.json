{
  "case_goal": "Reply to an existing message 'testMsg' in Collabtive project 'test' by entering reply text, selecting an attachment, and choosing a recipient, then verify successful submission.",
  "summary": "Log in as admin, navigate to project 'test', open message 'testMsg', click Reply, fill the reply form (text in WYSIWYG editor, select file and recipient), and save the reply.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page displayed with username and password fields."
    },
    {
      "action_type": "send_keys",
      "target": "input#username",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username 'admin' entered."
    },
    {
      "action_type": "send_keys",
      "target": "input#pass",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password entered."
    },
    {
      "action_type": "click",
      "target": "button[text='Login']",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Login succeeds, Desktop page loaded."
    },
    {
      "action_type": "click",
      "target": "link to project 'test'",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project 'test' page opened."
    },
    {
      "action_type": "click",
      "target": "#openall",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "All milestones expanded (if any)."
    },
    {
      "action_type": "click",
      "target": "link with text 'testMsg'",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Message 'testMsg' detail page displayed."
    },
    {
      "action_type": "click",
      "target": "#add_reply_a",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Reply form becomes visible with title 'Re: testMsg'."
    },
    {
      "action_type": "switch_frame",
      "target": "#text_ifr",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Switched to WYSIWYG editor iframe."
    },
    {
      "action_type": "send_keys",
      "target": "body inside iframe",
      "value": "test",
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Text 'test' entered in editor."
    },
    {
      "action_type": "click",
      "target": "#thefiles>option[2]",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "File 'TestImg_46267.png' selected."
    },
    {
      "action_type": "click",
      "target": "/select[@name='sendto[]']/option[5]",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&id=1&mid=1",
      "expected_result": "Recipient (likely 'test') selected."
    },
    {
      "action_type": "click",
      "target": "button[text='Save']",
      "value": null,
      "page_url": "http://collabtive-old.local:8084/managemessage.php?action=showmessage&mid=1&id=1&mode=replied",
      "expected_result": "Reply saved; page shows 'Replies: 1'."
    }
  ]
}