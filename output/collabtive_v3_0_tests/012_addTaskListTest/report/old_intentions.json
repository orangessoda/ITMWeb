{
  "case_goal": "Add a new task list to an existing project in Collabtive",
  "summary": "Logs in as admin, navigates to project 'test', goes to Tasks section, clicks 'Add Tasklist', fills in name 'test list' and description 'test', selects milestone, and submits.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "send_keys",
      "target": "username",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field contains 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "password",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field contains 'admin'"
    },
    {
      "action_type": "click",
      "target": "Login button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Desktop page appears"
    },
    {
      "action_type": "click",
      "target": "Project 'test' link",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project view page for project 'test'"
    },
    {
      "action_type": "click",
      "target": "Tasks tab",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Tasks page for the project"
    },
    {
      "action_type": "click",
      "target": "Add Tasklist button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Add task list form becomes visible"
    },
    {
      "action_type": "send_keys",
      "target": "Name field",
      "value": "test list",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Name field becomes 'test list'"
    },
    {
      "action_type": "switch_to_frame",
      "target": "Description iframe",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Focus inside iframe"
    },
    {
      "action_type": "send_keys",
      "target": "Description body",
      "value": "test",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Description contains 'test'"
    },
    {
      "action_type": "click",
      "target": "Milestone select",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Milestone dropdown opened"
    },
    {
      "action_type": "click",
      "target": "Milestone option 2 (test milestone)",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Milestone selected"
    },
    {
      "action_type": "click",
      "target": "Add button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1&mode=listadded",
      "expected_result": "Task list added, page shows mode=listadded"
    }
  ]
}