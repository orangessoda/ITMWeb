    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"contentwrapper\"]/div[1]/ul/li[3]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "Navigated to User Administration."
    },
    {
      "action_type": "find_element",
      "target": "xpath=/html/body/div[1]/div[2]/div[2]/div/div[3]/div[2]/table/tbody[1]/tr[1]/td[4]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/admin.php?action=users",
      "expected_result": "Element located (delete link for first role)."
