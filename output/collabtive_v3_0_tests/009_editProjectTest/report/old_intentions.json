    {
      "action_type": "click",
      "target": "//*[@id=\"form_addmyproject\"]/div/form/fieldset/div[8]/button[1]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Form submits, navigates to manageproject.php?action=showproject&id=1&mode=edited, title 'Project test @ Collabtive', displays budget 100 and customer details"
