{
  "case_goal": "Open a task in Collabtive",
  "summary": "Login as admin, navigate to project 'test', access task list, mark a task as done, view the task details, and then reopen the task.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "http://collabtive-old.local:8084/",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "fill",
      "target": "//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field filled with 'admin'"
    },
    {
      "action_type": "fill",
      "target": "//*[@id=\"pass\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"loginform\"]/fieldset/div[3]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Click on stay logged in area (page remains same)"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"loginform\"]/fieldset/div[4]/button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Desktop page displayed after successful login"
    },
    {
      "action_type": "click",
      "target": "/html/body/div[1]/div[2]/div[2]/div/div[4]/div/div[2]/div[2]/table/tbody/tr[1]/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project 'test' overview page displayed"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"contentwrapper\"]/div[1]/ul/li[3]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Tasks page for project 'test' displayed"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"toggle-2\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Second task list expanded (page URL unchanged)"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"donebutn_2\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Task marked as done (status change)"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"task_1\"]/tr/td[2]/div/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showtask&tid=1&id=1",
      "expected_result": "Task details page for 'test task' displayed"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"closetoggle\"]/a",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showtask&tid=1&id=1",
      "expected_result": "Task reopened (status changes to open)"
    }
  ]
}