{
  "case_goal": "Test quick search and find functionality: after logging in, select a project via quick finder, perform a search for 'test', and verify search results are displayed.",
  "summary": "Log in with admin credentials, use quick finder to select project 'test', then search for 'test' and confirm results page shows relevant items.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page displayed with username and password fields"
    },
    {
      "action_type": "send_keys",
      "target": "username",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username field contains 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "password",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Password field contains 'admin'"
    },
    {
      "action_type": "click",
      "target": "Login button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Redirected to Desktop page with title 'Desktop @ Collabtive'"
    },
    {
      "action_type": "click",
      "target": "content-right area",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/index.php?mode=login",
      "expected_result": "Desktop page remains displayed"
    },
    {
      "action_type": "select_option",
      "target": "Quick finder dropdown",
      "value": "option[2] (project 'test')",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Navigated to Project test page with title 'Project test @ Collabtive'"
    },
    {
      "action_type": "click",
      "target": "content-right area",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project page remains displayed"
    },
    {
      "action_type": "send_keys",
      "target": "Search query field",
      "value": "test",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Query field contains 'test'"
    },
    {
      "action_type": "click",
      "target": "Search button",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/managesearch.php?query=test&action=search",
      "expected_result": "Navigated to search results page with title 'Results @ Collabtive' and search results for 'test'"
    }
  ]
}