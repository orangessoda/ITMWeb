      "target": "xpath=//*[@id=\"username\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username input cleared"
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"username\"]",
      "value": "admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Username 'admin' entered"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id=\"pass\"]",
      "value": "",
      "page_url": "http://collabtive-old.local:8084/",
