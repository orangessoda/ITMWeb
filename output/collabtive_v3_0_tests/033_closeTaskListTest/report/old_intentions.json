{
  "case_goal": "Close a task list in a project",
  "summary": "Login to Collabtive, navigate to a project's tasks page, and close a task list.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "Login page",
      "value": "http://collabtive-old.local:8084/",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Login page displayed"
    },
    {
      "action_type": "login",
      "target": "Username and password fields",
      "value": "admin / admin",
      "page_url": "http://collabtive-old.local:8084/",
      "expected_result": "Logged in, desktop page displayed"
    },
    {
      "action_type": "click",
      "target": "Project link (first project in list)",
      "value": "/html/body/div[1]/div[2]/div[2]/div/div[4]/div/div[2]/div[2]/table/tbody/tr[1]/td[2]/div/a",
      "page_url": "http://collabtive-old.local:8084/manageproject.php?action=showproject&id=1",
      "expected_result": "Project test page displayed"
    },
    {
      "action_type": "click",
      "target": "Tasks tab",
      "value": "//*[@id=\"contentwrapper\"]/div[1]/ul/li[3]/a",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1",
      "expected_result": "Tasks page displayed"
    },
    {
      "action_type": "click",
      "target": "Close icon for task list",
      "value": "//*[@id=\"blockTasks\"]/div[3]/div/a[1]",
      "page_url": "http://collabtive-old.local:8084/managetask.php?action=showproject&id=1&mode=listclosed",
      "expected_result": "Task list closed, URL includes mode=listclosed"
    }
  ]
}