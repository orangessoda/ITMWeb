{
  "case_goal": "View profile statistics for a specific course (Math) as an authenticated user",
  "summary": "The test logs in as UserU, navigates to My User Account, clicks 'View my statistics', selects the Math course from the list, clicks 'Show all' to expand all statistics sections, and finally locates two elements within the statistics table to verify that detailed data is displayed.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Home page with login form displayed"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "UserU",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Username field filled with 'UserU'"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "passwordU",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field filled with 'passwordU'"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Logged in, homepage with user navigation links"
    },
    {
      "action_type": "click",
      "target": "link text=My User Account",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/auth/profile.php",
      "expected_result": "User profile page displayed with account details and 'View my statistics' link"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='claroBody']/p/a",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/tracking/personnalLog.php",
      "expected_result": "Statistics page listing courses (Math and Society)"
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='claroBody']/ul/li/a",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/tracking/userLog.php?uInfo=2&cidReset=true&cidReq=1b2e",
      "expected_result": "Statistics page for Math course with sections and 'Show all' link"
    },
    {
      "action_type": "click",
      "target": "link text=Show all",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/tracking/userLog.php?uInfo=2&view=1111111",
      "expected_result": "All statistics sections expanded (logins, exercises, learning path, etc.)"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[2]/tbody[2]/tr/td[1]/a",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/tracking/userLog.php?uInfo=2&view=1111111",
      "expected_result": "Element located (e.g., a link to details)"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[2]/tbody[2]/tr/td[3]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/tracking/userLog.php?uInfo=2&view=1111111",
      "expected_result": "Element located (e.g., a text cell)"
    }
  ]
}