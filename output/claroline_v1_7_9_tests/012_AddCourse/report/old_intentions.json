{
  "case_goal": "Add a new course in Claroline",
  "summary": "Login as admin, navigate to Platform Administration, create a course with title 'Math' and code '1', enable enrollment and visibility, submit and verify the course appears in the course list.",
  "steps": [
    {
      "action_type": "get",
      "target": "url=http://claroline-old.local:8088/",
      "value": null,
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login page with username and password fields"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Username field contains 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field contains 'admin'"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": null,
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Logged in, navigation bar appears with 'Platform Administration' and 'My course list' links"
    },
    {
      "action_type": "click",
      "target": "link text=Platform Administration",
      "value": null,
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Administration page with title 'Administration - claroline' and 'Create course' link"
    },
    {
      "action_type": "click",
      "target": "link text=Create course",
      "value": null,
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Course creation form with fields: title, official code, holder, email, category, etc."
    },
    {
      "action_type": "send_keys",
      "target": "id=title",
      "value": "Math",
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Title field filled with 'Math'"
    },
    {
      "action_type": "send_keys",
      "target": "id=officialCode",
      "value": "1",
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Official code field filled with '1'"
    },
    {
      "action_type": "click",
      "target": "id=category",
      "value": null,
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Category dropdown clicked (default selection remains)"
    },
    {
      "action_type": "click",
      "target": "id=courseEnrollAllowed_true",
      "value": null,
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Enrollment allowed radio button selected"
    },
    {
      "action_type": "click",
      "target": "id=courseVisibility_true",
      "value": null,
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Course visibility set to visible"
    },
    {
      "action_type": "click",
      "target": "name=submitFromCoursProperties",
      "value": null,
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?cmd=exCreate&title=Math&officialCode=1&holder=admin%20admin&email=admin%40example.com&category=SC&extLinkName=&extLinkUrl=&languageCourse=english&courseVisibility=true&courseEnrollAllowed=true&enrollmentKey=&submitFromCoursProper",
      "expected_result": "Course created, confirmation page shows 'Back to my course list' link"
    },
    {
      "action_type": "click",
      "target": "link text=Back to my course list",
      "value": null,
      "page_url": "http://claroline-old.local:8088/index.php",
      "expected_result": "Home page displays new course '1 - Math' in course list"
    }
  ]
}