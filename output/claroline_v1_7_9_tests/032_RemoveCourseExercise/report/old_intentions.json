{
  "case_goal": "Remove an exercise from a course in Claroline",
  "summary": "Log in as admin, navigate to Math course, access Exercises, then delete the second exercise (Exercise 1) using a script to confirm deletion.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Homepage of Claroline displayed"
    },
    {
      "action_type": "find_element",
      "target": "id",
      "value": "login",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field located"
    },
    {
      "action_type": "clear",
      "target": "id=login",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Text 'admin' entered in login field"
    },
    {
      "action_type": "find_element",
      "target": "id",
      "value": "password",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field located"
    },
    {
      "action_type": "clear",
      "target": "id=password",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Text 'admin' entered in password field"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login submitted, admin dashboard displayed"
    },
    {
      "action_type": "click",
      "target": "link text=1 - Math",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Navigate to Math course page"
    },
    {
      "action_type": "click",
      "target": "link text=Exercises",
      "value": "",
      "page_url": "http://claroline-old.local:8088/courses/1b2e/",
      "expected_result": "Exercises list page displayed"
    },
    {
      "action_type": "find_element",
      "target": "xpath",
      "value": "(//img[@alt='Delete'])[2]",
      "page_url": "http://claroline-old.local:8088/claroline/exercice/exercice.php",
      "expected_result": "Delete icon for 'Exercise 1' found"
    },
    {
      "action_type": "execute_script",
      "target": "",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://claroline-old.local:8088/claroline/exercice/exercice.php",
      "expected_result": "Exercise 'Exercise 1' deleted, page reloads with confirmation bypassed"
    },
    {
      "action_type": "find_element",
      "target": "tag name",
      "value": "body",
      "page_url": "http://claroline-old.local:8088/claroline/exercice/exercice.php?choice=delete&exerciseId=2",
      "expected_result": "Page body loaded after deletion"
    }
  ]
}