{
  "case_goal": "Enable visibility of an exercise in the Math course so that students can see it.",
  "summary": "Admin logs in, navigates to Math course exercises, and enables the 'Exercise 1' exercise to make it visible.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Open Claroline homepage"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Enter username 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Enter password 'admin'"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Log in as admin, see platform administration links and course list"
    },
    {
      "action_type": "click",
      "target": "link text=1 - Math",
      "value": "",
      "page_url": "http://claroline-old.local:8088/courses/1b2e/",
      "expected_result": "Navigate to Math course home page"
    },
    {
      "action_type": "click",
      "target": "link text=Exercises",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/exercice/exercice.php",
      "expected_result": "Open exercises list page"
    },
    {
      "action_type": "click",
      "target": "xpath=(//img[@alt='Enable'])[2]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/exercice/exercice.php?choice=enable&offset=0&exerciseId=2",
      "expected_result": "Enable Exercise 1, change enable icon to disable icon"
    }
  ]
}