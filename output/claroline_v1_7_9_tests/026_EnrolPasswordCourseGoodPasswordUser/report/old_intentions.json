{
  "case_goal": "Enrol on a password-protected course using the correct password as a user",
  "summary": "User 'UserU' logs in with password 'passwordU', navigates to course enrolment, searches for course 'Society', selects the course, enters the correct enrolment key 'password', and verifies successful enrolment.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Page opens with title 'claroline'"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "UserU",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field filled with 'UserU'"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "passwordU",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "User logged in, user options visible"
    },
    {
      "action_type": "click",
      "target": "link text=Enrol on a new course",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php?cmd=rqReg&category=",
      "expected_result": "Enrolment page with course categories and search"
    },
    {
      "action_type": "send_keys",
      "target": "id=keyword",
      "value": "Society",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php?cmd=rqReg&category=",
      "expected_result": "Search field filled with 'Society'"
    },
    {
      "action_type": "click",
      "target": "css=input[type='submit']",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php",
      "expected_result": "Search results page with courses matching 'Society'"
    },
    {
      "action_type": "click",
      "target": "css=a > img",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php?cmd=exReg&course=250f",
      "expected_result": "Enrolment key entry page for the selected course"
    },
    {
      "action_type": "send_keys",
      "target": "name=enrollmentKey",
      "value": "password",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php?cmd=exReg&course=250f",
      "expected_result": "Enrolment key field filled with 'password'"
    },
    {
      "action_type": "click",
      "target": "css=input[type='submit']",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php",
      "expected_result": "Enrolment completed, success page shown"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/blockquote/table/tbody/tr/td/p[1]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/auth/courses.php",
      "expected_result": "Element indicating successful enrolment is present"
    }
  ]
}