{
  "case_goal": "Search for a student user by last name using advanced user search in the administration panel.",
  "summary": "Admin logs in, navigates to Platform Administration, opens Advanced user search, enters last name 'testuser1', and searches. The expected result is to see the user listed.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login page displayed with username and password fields."
    },
    {
      "action_type": "clear",
      "target": "id=login",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field contains 'admin'."
    },
    {
      "action_type": "clear",
      "target": "id=password",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field contains 'admin'."
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "User is logged in, admin links visible."
    },
    {
      "action_type": "click",
      "target": "link text=Platform Administration",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Administration page displayed with user and course sections."
    },
    {
      "action_type": "click",
      "target": "link text=Advanced",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedUserSearch.php",
      "expected_result": "Advanced user search form displayed with fields: last name, first name, username, email, and role selector."
    },
    {
      "action_type": "clear",
      "target": "id=lastName",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedUserSearch.php",
      "expected_result": "Last name field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "id=lastName",
      "value": "testuser1",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedUserSearch.php",
      "expected_result": "Last name field shows 'testuser1'."
    },
    {
      "action_type": "click",
      "target": "unknown",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedUserSearch.php",
      "expected_result": "Likely clicked on the action select (no visible change)."
    },
    {
      "action_type": "click",
      "target": "css selector=input.claroButton",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?lastName=testuser1&firstName=&userName=&mail=&action=followcourse",
      "expected_result": "User list page displayed with search results filtered by last name 'testuser1'."
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[3]/tbody/tr[1]/td[2]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?lastName=testuser1&firstName=&userName=&mail=&action=followcourse",
      "expected_result": "Element found, indicating user 'testuser1' is listed."
    }
  ]
}