{
  "case_goal": "Verify that attempting to create a course with empty required fields displays an error message.",
  "summary": "Admin logs in, navigates to Platform Administration, clicks on Create course, submits the empty form, and then checks for an error message indicating missing title.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Homepage loads"
    },
    {
      "action_type": "clear",
      "target": "id=login",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field populated with 'admin'"
    },
    {
      "action_type": "clear",
      "target": "id=password",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field populated with 'admin'"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login successful, homepage reloaded with user menu"
    },
    {
      "action_type": "click",
      "target": "link text=Platform Administration",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Navigates to Platform Administration page"
    },
    {
      "action_type": "click",
      "target": "link text=Create course",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Navigates to Create course form"
    },
    {
      "action_type": "click",
      "target": "name=submitFromCoursProperties",
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php?fromAdmin=yes",
      "expected_result": "Form submitted, page reloads with error message due to missing required fields"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[1]/tbody/tr/td",
      "page_url": "http://claroline-old.local:8088/claroline/create_course/add_course.php",
      "expected_result": "Error message element present"
    }
  ]
}