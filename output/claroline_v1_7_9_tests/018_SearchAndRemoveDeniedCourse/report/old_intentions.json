{
  "case_goal": "Search for a course with denied subscription and remove it",
  "summary": "Admin logs in, navigates to platform administration, performs advanced course search for a course with 'Music' in the title and subscription denied, then deletes the found course.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "page opened successfully"
    },
    {
      "action_type": "login",
      "target": "login form",
      "value": "admin/admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "login successful"
    },
    {
      "action_type": "click",
      "target": "link text",
      "value": "Platform Administration",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "navigate to admin page"
    },
    {
      "action_type": "click",
      "target": "css selector",
      "value": "form[name='searchCourse'] > small > a",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "navigate to advanced course search"
    },
    {
      "action_type": "send_keys",
      "target": "id",
      "value": "intitule",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedCourseSearch.php",
      "expected_result": "typed 'Music'"
    },
    {
      "action_type": "click",
      "target": "id",
      "value": "subscription_denied",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedCourseSearch.php",
      "expected_result": "selected denied subscription"
    },
    {
      "action_type": "click",
      "target": "css selector",
      "value": "input.claroButton",
      "page_url": "http://claroline-old.local:8088/claroline/admin/advancedCourseSearch.php",
      "expected_result": "search results displayed"
    },
    {
      "action_type": "execute_script",
      "target": "delete icon",
      "value": "window.confirm = function(){ return true; }; arguments[0].click();",
      "page_url": "http://claroline-old.local:8088/claroline/admin/admincourses.php?code=&intitule=Music&category=&language=&access=&subscription=denied",
      "expected_result": "course deleted"
    },
    {
      "action_type": "find_element",
      "target": "xpath",
      "value": "//*[@id='claroBody']/table[1]/tbody/tr/td",
      "page_url": "http://claroline-old.local:8088/claroline/admin/admincourses.php",
      "expected_result": "element found (verification)"
    }
  ]
}