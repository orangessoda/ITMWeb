{
  "case_goal": "Add a course event titled 'Exam 1' to the Math course's agenda",
  "summary": "Login as admin, navigate to Math course, access Agenda, add an event with title 'Exam 1', and verify the event appears in the agenda list.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Homepage displayed with login form"
    },
    {
      "action_type": "login",
      "target": "username/password",
      "value": "admin/admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Logged in, see 'My course list' and other admin links"
    },
    {
      "action_type": "click",
      "target": "link text",
      "value": "1 - Math",
      "page_url": "http://claroline-old.local:8088/courses/1b2e/",
      "expected_result": "Course home page for Math displayed with course tools"
    },
    {
      "action_type": "click",
      "target": "link text",
      "value": "Agenda",
      "page_url": "http://claroline-old.local:8088/claroline/calendar/agenda.php",
      "expected_result": "Agenda page with 'Add an event' link"
    },
    {
      "action_type": "click",
      "target": "link text",
      "value": "Add an event",
      "page_url": "http://claroline-old.local:8088/claroline/calendar/agenda.php?cmd=rqAdd",
      "expected_result": "Event creation form displayed with title field, date selectors, and submit button"
    },
    {
      "action_type": "type",
      "target": "id",
      "value": "title = Exam 1",
      "page_url": "http://claroline-old.local:8088/claroline/calendar/agenda.php?cmd=rqAdd",
      "expected_result": "Title field filled with 'Exam 1'"
    },
    {
      "action_type": "select",
      "target": "id",
      "value": "fday, fmonth, fyear (default values)",
      "page_url": "http://claroline-old.local:8088/claroline/calendar/agenda.php?cmd=rqAdd",
      "expected_result": "Date fields selected (default date)"
    },
    {
      "action_type": "click",
      "target": "name",
      "value": "submitEvent",
      "page_url": "http://claroline-old.local:8088/claroline/calendar/agenda.php",
      "expected_result": "Event added, redirect to agenda list showing 'Exam 1' event with edit/delete options"
    },
    {
      "action_type": "verify",
      "target": "xpath",
      "value": "//*[@id='claroBody']/table[1]/tbody/tr/td",
      "page_url": "http://claroline-old.local:8088/claroline/calendar/agenda.php",
      "expected_result": "Event details visible in the agenda list"
    }
  ]
}