{
  "case_goal": "Remove multiple user accounts from the platform",
  "summary": "Admin logs in, navigates to Platform Administration, searches for 'testuser', and deletes the resulting user accounts by clicking the delete icon and confirming via JavaScript. Then verifies the deletion.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Homepage is displayed with login form"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field filled with 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "User logged in and redirected to homepage with admin menu"
    },
    {
      "action_type": "click",
      "target": "link text=Platform Administration",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Admin page opens with user search and management options"
    },
    {
      "action_type": "send_keys",
      "target": "id=search_user",
      "value": "testuser",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Search field filled with 'testuser'"
    },
    {
      "action_type": "click",
      "target": "css selector=form[name='searchUser'] > input[type='submit']",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Search results displayed showing users matching 'testuser'"
    },
    {
      "action_type": "execute_script",
      "target": "window.confirm = function(){ return true; }; arguments[0].click();",
      "value": "img[alt='Delete']",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "First user (user_id=3) deleted and redirect to adminusers.php with confirmation"
    },
    {
      "action_type": "execute_script",
      "target": "window.confirm = function(){ return true; }; arguments[0].click();",
      "value": "img[alt='Delete']",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?cmd=delete&user_id=3&ffset=0",
      "expected_result": "Second user (user_id=4) deleted and redirect to adminusers.php with updated user list"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[1]/tbody/tr/td",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?cmd=delete&user_id=4&ffset=0",
      "expected_result": "Element found indicating deletion success or empty list"
    }
  ]
}