{
  "case_goal": "Verify that creating a new user with mismatched passwords displays an error message and prevents user creation.",
  "summary": "Admin logs into Claroline, navigates to Platform Administration, clicks 'Create user', fills in new user form with mismatched passwords (password vs passowrd), submits the form, and checks for an error message indicating password mismatch.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Homepage is displayed with login form"
    },
    {
      "action_type": "type",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field filled with 'admin'"
    },
    {
      "action_type": "type",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field filled with 'admin'"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Successfully logged in as admin, main page with admin links displayed"
    },
    {
      "action_type": "click",
      "target": "link text=Platform Administration",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Navigated to administration page with user management options"
    },
    {
      "action_type": "click",
      "target": "link text=Create user",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Navigated to 'Create a new user' form page"
    },
    {
      "action_type": "type",
      "target": "id=lastname",
      "value": "user",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "Last name field filled with 'user'"
    },
    {
      "action_type": "type",
      "target": "id=firstname",
      "value": "user",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "First name field filled with 'user'"
    },
    {
      "action_type": "type",
      "target": "id=username",
      "value": "user",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "Username field filled with 'user'"
    },
    {
      "action_type": "type",
      "target": "id=password",
      "value": "password",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "Password field filled with 'password'"
    },
    {
      "action_type": "type",
      "target": "id=password_conf",
      "value": "passowrd",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "Password confirmation field filled with 'passowrd' (mismatch intended)"
    },
    {
      "action_type": "click",
      "target": "css selector=input[type=submit]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "Form submitted; error message displayed due to password mismatch; user not created"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[1]/tbody/tr/td",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminaddnewuser.php",
      "expected_result": "Element containing error message about password mismatch is present"
    }
  ]
}