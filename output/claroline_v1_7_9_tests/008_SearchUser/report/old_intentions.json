{
  "case_goal": "Search for a user by last name 'Smith' in the Claroline platform administration.",
  "summary": "The test logs in as admin, navigates to platform administration, and uses the search user functionality to find users with last name 'Smith'. It then checks the search results by locating specific table cells.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://claroline-old.local:8088/",
      "page_url": "",
      "expected_result": "Homepage is loaded"
    },
    {
      "action_type": "find_element",
      "target": "id=login",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field is present"
    },
    {
      "action_type": "clear",
      "target": "id=login",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login field is cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=login",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Typed 'admin' into login field"
    },
    {
      "action_type": "find_element",
      "target": "id=password",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field is present"
    },
    {
      "action_type": "clear",
      "target": "id=password",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Password field is cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=password",
      "value": "admin",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Typed 'admin' into password field"
    },
    {
      "action_type": "find_element",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Submit button is present"
    },
    {
      "action_type": "click",
      "target": "name=submitAuth",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Login form submitted, navigates to page with admin menu"
    },
    {
      "action_type": "find_element",
      "target": "link text=Platform Administration",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Platform Administration link is present"
    },
    {
      "action_type": "click",
      "target": "link text=Platform Administration",
      "value": "",
      "page_url": "http://claroline-old.local:8088/",
      "expected_result": "Navigated to Platform Administration page"
    },
    {
      "action_type": "find_element",
      "target": "id=search_user",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Search user input is present"
    },
    {
      "action_type": "clear",
      "target": "id=search_user",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Search input is cleared"
    },
    {
      "action_type": "send_keys",
      "target": "id=search_user",
      "value": "Smith",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Typed 'Smith' into search field"
    },
    {
      "action_type": "find_element",
      "target": "css selector=form[name='searchUser'] > input[type='submit']",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Search submit button is present"
    },
    {
      "action_type": "click",
      "target": "css selector=form[name='searchUser'] > input[type='submit']",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/",
      "expected_result": "Search submitted, navigates to user list page with search parameter"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[3]/tbody/tr/td[2]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?search=Smith",
      "expected_result": "Last name cell is present in search results"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[3]/tbody/tr/td[3]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?search=Smith",
      "expected_result": "First name cell is present in search results"
    },
    {
      "action_type": "find_element",
      "target": "xpath=//*[@id='claroBody']/table[3]/tbody/tr/td[6]",
      "value": "",
      "page_url": "http://claroline-old.local:8088/claroline/admin/adminusers.php?search=Smith",
      "expected_result": "Email cell is present in search results"
    }
  ]
}