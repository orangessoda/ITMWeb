{
  "case_goal": "Edit a role category: change its name and save.",
  "summary": "Log in as admin, navigate to Groups & roles, open Categories, edit the existing 'test' category by renaming it to '123', select a default group setting, and save the changes.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page loads with login form visible."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id='plg_usr_login_name']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login name field filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id='plg_usr_password']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='next_page']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "User is logged in and redirected to overview page with admin menu."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='groups-roles']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php",
      "expected_result": "Groups & roles page loads."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='menu_item_groups_roles_maintain_categories']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories.php?type=ROL",
      "expected_result": "Categories page for roles loads."
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/div[2]/div/div[2]/div/div[2]/table/tbody/tr[6]/td[6]/a[1]",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories_new.php?cat_uuid=2b705de6-0d79-46bf-8328-bc1785153247&type=ROL",
      "expected_result": "Edit category form for the 'test' category opens."
    },
    {
      "action_type": "clear",
      "target": "xpath=//*[@id='cat_name']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories_new.php?cat_uuid=2b705de6-0d79-46bf-8328-bc1785153247&type=ROL",
      "expected_result": "Category name field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id='cat_name']",
      "value": "123",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories_new.php?cat_uuid=2b705de6-0d79-46bf-8328-bc1785153247&type=ROL",
      "expected_result": "Category name changed to '123'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='cat_default_group']/div/div/label",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories_new.php?cat_uuid=2b705de6-0d79-46bf-8328-bc1785153247&type=ROL",
      "expected_result": "Default group selection toggled (checkbox or radio)."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='btn_save']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories.php?type=ROL",
      "expected_result": "Category saved, redirected to categories list. The 'test' category now shows as '123'."
    }
  ]
}