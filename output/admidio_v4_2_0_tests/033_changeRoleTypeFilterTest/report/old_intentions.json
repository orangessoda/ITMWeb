{
  "case_goal": "Verify that the role type filter on the Groups & roles page correctly updates the displayed roles when selecting different filter options.",
  "summary": "Login as admin, navigate to Groups & roles, then sequentially select 'Inactive groups and roles', 'Active groups and roles', and 'Roles - Confirmation of attendance' from the role_type dropdown, each time verifying the page updates with the corresponding title and URL.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page opened with login form visible"
    },
    {
      "action_type": "send_keys",
      "target": "#plg_usr_login_name",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login field filled"
    },
    {
      "action_type": "send_keys",
      "target": "#plg_usr_password",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "#next_page",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login successful, redirected to overview page with 'Sign out' link"
    },
    {
      "action_type": "click",
      "target": "#groups-roles",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigated to Groups & roles page (title: 'Groups & roles')"
    },
    {
      "action_type": "click",
      "target": "#role_type",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php",
      "expected_result": "Dropdown opened"
    },
    {
      "action_type": "click",
      "target": "#role_type/option[2]",
      "value": "Inactive groups and roles",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php",
      "expected_result": "Filter changes to inactive, URL includes role_type=0, title 'Inactive groups and roles'"
    },
    {
      "action_type": "click",
      "target": "#role_type",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php?show=card&cat_uuid=0&role_type=0",
      "expected_result": "Dropdown opened"
    },
    {
      "action_type": "click",
      "target": "#role_type/option[3]",
      "value": "Active groups and roles",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php?show=card&cat_uuid=0&role_type=0",
      "expected_result": "Filter changes to active, URL includes role_type=1, title 'Groups & roles'"
    },
    {
      "action_type": "click",
      "target": "#role_type",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php?show=card&cat_uuid=0&role_type=1",
      "expected_result": "Dropdown opened"
    },
    {
      "action_type": "click",
      "target": "#role_type/option[4]",
      "value": "Roles - Confirmation of attendance",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php?show=card&cat_uuid=0&role_type=1",
      "expected_result": "Filter changes to confirmation of attendance, URL includes role_type=2, title 'Roles - Confirmation of attendance'"
    }
  ]
}