{
  "case_goal": "Verify that the user change history table can be filtered by date range, sorted by each column, and searched by keyword.",
  "summary": "Login as admin, navigate to Paul Schmidt's profile, open change history, set date filter from 2023-11-10 to 2026-05-03, sort by each column header, and search for 'test' to validate table functionality.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Overview page loaded with login form visible."
    },
    {
      "action_type": "send_keys",
      "target": "id=plg_usr_login_name",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login name field filled."
    },
    {
      "action_type": "send_keys",
      "target": "id=plg_usr_password",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled."
    },
    {
      "action_type": "click",
      "target": "id=next_page",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login successful, redirected to overview with admin menu (e.g., 'My profile' link)."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"navbarNav\"]/ul/li[1]/a",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigated to 'My profile' page (profile.php) showing admin profile."
    },
    {
      "action_type": "click",
      "target": "id=menu_item_profile_change_history",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/profile/profile.php",
      "expected_result": "Change history page loaded with filter fields and table."
    },
    {
      "action_type": "send_keys",
      "target": "id=filter_date_from",
      "value": "002023-11-10",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php",
      "expected_result": "Date from field set to 2023-11-10 (leading zeros trimmed)."
    },
    {
      "action_type": "click",
      "target": "id=btn_send",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php",
      "expected_result": "Table filtered, URL updated with filter parameters, showing changes within date range."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"profile_field_history_table\"]/thead/tr/th[1]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php?filter_date_from=2023-11-10&filter_date_to=2026-05-03",
      "expected_result": "Table sorted by first column (likely 'Date')."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"profile_field_history_table\"]/thead/tr/th[2]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php?filter_date_from=2023-11-10&filter_date_to=2026-05-03",
      "expected_result": "Table sorted by second column (likely 'Field')."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"profile_field_history_table\"]/thead/tr/th[3]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php?filter_date_from=2023-11-10&filter_date_to=2026-05-03",
      "expected_result": "Table sorted by third column (likely 'Old Value')."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"profile_field_history_table\"]/thead/tr/th[4]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php?filter_date_from=2023-11-10&filter_date_to=2026-05-03",
      "expected_result": "Table sorted by fourth column (likely 'New Value')."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"profile_field_history_table\"]/thead/tr/th[5]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php?filter_date_from=2023-11-10&filter_date_to=2026-05-03",
      "expected_result": "Table sorted by fifth column (likely 'Edit By')."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"profile_field_history_table_filter\"]/label/input",
      "value": "test",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/members/profile_field_history.php?filter_date_from=2023-11-10&filter_date_to=2026-05-03",
      "expected_result": "Table filtered to show only rows containing 'test' in any visible column."
    }
  ]
}