{
  "case_goal": "Test sorting and filtering of messages table",
  "summary": "Logs in as admin, navigates to Messages page, sorts by multiple columns, changes page length, and filters messages by text 'test'.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page loads with login form"
    },
    {
      "action_type": "send_keys",
      "target": "input#plg_usr_login_name",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login name entered"
    },
    {
      "action_type": "send_keys",
      "target": "input#plg_usr_password",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password entered"
    },
    {
      "action_type": "click",
      "target": "button#next_page",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login succeeds, redirects to overview with admin menu"
    },
    {
      "action_type": "click",
      "target": "a#messages",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigates to Messages page"
    },
    {
      "action_type": "click",
      "target": "th:first-child",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Table sorted by first column"
    },
    {
      "action_type": "click",
      "target": "th:nth-child(2)",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Table sorted by second column"
    },
    {
      "action_type": "click",
      "target": "th:nth-child(4)",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Table sorted by fourth column"
    },
    {
      "action_type": "click",
      "target": "th:nth-child(5)",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Table sorted by fifth column"
    },
    {
      "action_type": "click",
      "target": "select#adm_message_table_length",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Dropdown opened"
    },
    {
      "action_type": "select_option",
      "target": "option:nth-child(3)",
      "value": "25",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Page length changed to 25"
    },
    {
      "action_type": "send_keys",
      "target": "input[type='search']",
      "value": "test",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/messages/messages.php",
      "expected_result": "Table filtered to show messages containing 'test'"
    }
  ]
}