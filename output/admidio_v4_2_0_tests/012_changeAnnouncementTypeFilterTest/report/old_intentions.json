{
  "case_goal": "Verify that the announcement category filter correctly filters announcements by selecting 'All', 'All organizations', and 'General' categories.",
  "summary": "The test logs in as admin, navigates to the Announcements page, and then interacts with the category filter dropdown. It selects the 'All' option first, then 'All organizations', and finally 'General', verifying that the page title and URL update to reflect the selected filter.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page loaded with title 'Demo-Organisation - Overview'"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"plg_usr_login_name\"]",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username 'admin' entered"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"plg_usr_password\"]",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password entered"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"next_page\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Logged in as admin, title 'Demo-Organisation - Overview'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"announcements\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php",
      "expected_result": "Navigated to Announcements page, title 'Demo-Organisation - Announcements'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"cat_uuid\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php",
      "expected_result": "Category filter dropdown opened"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"cat_uuid\"]/option[1]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php",
      "expected_result": "Filter set to 'All', page title remains 'Demo-Organisation - Announcements'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"cat_uuid\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php",
      "expected_result": "Category filter dropdown opened"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"cat_uuid\"]/option[2]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php?headline=Announcements&cat_uuid=a657459f-cef8-4f68-8008-0c5e34f4bfa5",
      "expected_result": "Filter set to 'All organizations', page title 'Demo-Organisation - Announcements - All organizations'"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"cat_uuid\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php?headline=Announcements&cat_uuid=a657459f-cef8-4f68-8008-0c5e34f4bfa5",
      "expected_result": "Category filter dropdown opened"
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"cat_uuid\"]/option[3]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php?headline=Announcements+-+All+organizations&cat_uuid=ab11ce61-471b-4f49-8735-92134b417d6e",
      "expected_result": "Filter set to 'General', page title 'Demo-Organisation - Announcements - All organizations - General'"
    }
  ]
}