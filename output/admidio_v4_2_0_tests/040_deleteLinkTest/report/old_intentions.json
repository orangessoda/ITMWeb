{
  "case_goal": "Delete a web link from the Web links module after logging in as admin.",
  "summary": "Logs in with admin credentials, navigates to Web links, clicks the delete icon on the first link (baidu), and confirms deletion.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Overview page loads with login form (Sign in button, username/password fields)."
    },
    {
      "action_type": "send_keys",
      "target": "plg_usr_login_name",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username field is filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "plg_usr_password",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field is filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "next_page",
      "value": "Sign in",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "User is logged in; overview page reloads with admin menu (My profile, Sign out, and additional navigation items)."
    },
    {
      "action_type": "click",
      "target": "weblinks",
      "value": "Web links",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links.php",
      "expected_result": "Web links page loads showing list of links (e.g., 'baidu') with edit/delete options."
    },
    {
      "action_type": "click",
      "target": "/html/body/div[2]/div/div[2]/div/div[2]/div/div[2]/div/a[3]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links.php",
      "expected_result": "A confirmation dialog appears asking to delete the link (with 'Yes' and 'No' buttons)."
    },
    {
      "action_type": "click",
      "target": "btn_yes",
      "value": "Yes",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links.php",
      "expected_result": "Link is deleted; page refreshes and the deleted link is no longer displayed."
    }
  ]
}