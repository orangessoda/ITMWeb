{
  "case_goal": "Verify that an administrator can delete a link category from the Web links categories page.",
  "summary": "Login as admin, navigate to Web links, edit categories, delete the third category (named '123'), and confirm deletion.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login page displayed with username, password fields and Sign in button."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"plg_usr_login_name\"]",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username field filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id=\"plg_usr_password\"]",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"next_page\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login successful, redirected to overview page with admin menu."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"weblinks\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigated to Web links page with 'Create new link' and 'Edit categories' buttons."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"menu_item_links_maintain_categories\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links.php",
      "expected_result": "Navigated to categories page showing list of link categories."
    },
    {
      "action_type": "click",
      "target": "/html/body/div[2]/div/div[2]/div/div[2]/table/tbody/tr[3]/td[6]/a[2]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories.php?type=LNK&title=Web%20links",
      "expected_result": "Confirmation dialog appears asking to delete the category."
    },
    {
      "action_type": "click",
      "target": "//*[@id=\"btn_yes\"]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/categories/categories.php?type=LNK&title=Web%20links",
      "expected_result": "Category deleted, page refreshes and category is no longer in list."
    }
  ]
}