{
  "case_goal": "Create a new role in Admidio",
  "summary": "Admin logs in, navigates to Groups & roles, clicks Create role, fills in name and description, selects category, and saves.",
  "steps": [
    {
      "action_type": "navigate",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page loads with login form"
    },
    {
      "action_type": "type",
      "target": "//*[@id='plg_usr_login_name']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username field filled"
    },
    {
      "action_type": "type",
      "target": "//*[@id='plg_usr_password']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled"
    },
    {
      "action_type": "click",
      "target": "//*[@id='next_page']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Redirect to overview page with admin logged in"
    },
    {
      "action_type": "click",
      "target": "//*[@id='groups-roles']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Groups & roles page displayed"
    },
    {
      "action_type": "click",
      "target": "//*[@id='menu_item_groups_roles_add']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles.php",
      "expected_result": "Create role form displayed"
    },
    {
      "action_type": "type",
      "target": "//*[@id='rol_name']",
      "value": "test",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles_new.php",
      "expected_result": "Role name field filled"
    },
    {
      "action_type": "type",
      "target": "//*[@id='rol_description']",
      "value": "test",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles_new.php",
      "expected_result": "Description field filled"
    },
    {
      "action_type": "select",
      "target": "//*[@id='rol_cat_id']",
      "value": "option[2]",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles_new.php",
      "expected_result": "Category selected (General)"
    },
    {
      "action_type": "click",
      "target": "//*[@id='btn_save']",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/groups-roles/groups_roles_new.php",
      "expected_result": "Role saved (page remains on create role form)"
    }
  ]
}