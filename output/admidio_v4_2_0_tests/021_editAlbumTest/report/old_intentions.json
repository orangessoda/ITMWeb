{
  "case_goal": "Verify that an existing photo album can be edited by changing its description and saving the changes.",
  "summary": "As an admin user, navigate to the Photos module, open the dropdown menu for the existing album 'test', select 'Edit album', change the description from 'test' to '123', and save. The test expects successful redirection back to the photo albums page.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page 'Demo-Organisation - Overview' is displayed with login form."
    },
    {
      "action_type": "send_keys",
      "target": "input#plg_usr_login_name",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username field filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "input#plg_usr_password",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "button#next_page",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login successful, redirect to same overview page now showing 'My profile' and 'Sign out' links."
    },
    {
      "action_type": "click",
      "target": "a#photo",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigate to photo albums page: 'Demo-Organisation - Photo albums'."
    },
    {
      "action_type": "click",
      "target": "a#dropdownMenuButton",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/photos/photos.php",
      "expected_result": "Dropdown menu opens with 'Edit album', 'Lock album', 'Delete album' options."
    },
    {
      "action_type": "click",
      "target": "a (first child of dropdown) - Edit album",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/photos/photos.php",
      "expected_result": "Navigate to edit album page: 'Demo-Organisation - Edit album' with form fields pre-filled."
    },
    {
      "action_type": "clear",
      "target": "textarea#pho_description",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/photos/photo_album_new.php?photo_uuid=ad60dc33-c3ae-4bb7-b3d0-e475dba3f148&mode=change",
      "expected_result": "Description field cleared."
    },
    {
      "action_type": "send_keys",
      "target": "textarea#pho_description",
      "value": "123",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/photos/photo_album_new.php?photo_uuid=ad60dc33-c3ae-4bb7-b3d0-e475dba3f148&mode=change",
      "expected_result": "Description field now contains '123'."
    },
    {
      "action_type": "click",
      "target": "button#btn_save",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/photos/photo_album_new.php?photo_uuid=ad60dc33-c3ae-4bb7-b3d0-e475dba3f148&mode=change",
      "expected_result": "Album saved, redirect to 'Demo-Organisation - Photo albums' page."
    }
  ]
}