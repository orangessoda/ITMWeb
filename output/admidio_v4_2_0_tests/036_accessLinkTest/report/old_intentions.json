{
  "case_goal": "Verify that clicking a web link in Admidio redirects to the correct external site.",
  "summary": "The test logs in as admin, navigates to Web links page, clicks on the first link (test), which opens a redirect page, then clicks the external link (here) leading to baidu.com, and finally switches back to the original window.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page opens successfully with title 'Demo-Organisation - Overview'."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id='plg_usr_login_name']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username field is filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id='plg_usr_password']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field is filled with 'admin'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='next_page']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login successful, page reloads with admin menu items (e.g., 'My profile', 'Sign out')."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='weblinks']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigates to Web links page with title 'Demo-Organisation - Web links' and lists existing links."
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/div[2]/div/div[2]/div/div[2]/div/div[2]/div/a[1]",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links.php",
      "expected_result": "A new window opens with the redirect page for the first link (test)."
    },
    {
      "action_type": "switch_window",
      "target": "window handle: 09CBD5F8B3CFE61DD422CE6254FBCE4D",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links_redirect.php?link_uuid=ee8deb42-4c6b-4b81-a985-9964249e1ba3",
      "expected_result": "Switch to the redirect page with title 'Demo-Organisation - Redirect'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id='content']/p/a",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links_redirect.php?link_uuid=ee8deb42-4c6b-4b81-a985-9964249e1ba3",
      "expected_result": "Redirects to external site 'https://www.baidu.com/' (Chinese search engine)."
    },
    {
      "action_type": "switch_window",
      "target": "window handle: 9737AB0ADC45311195249C841A4BEC24",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/links/links.php",
      "expected_result": "Switch back to the original Web links page."
    }
  ]
}