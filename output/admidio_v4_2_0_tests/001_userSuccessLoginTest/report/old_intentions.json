{
  "case_goal": "Test successful user login with valid credentials",
  "summary": "Navigate to homepage, fill in login form with admin/admin, submit, verify successful login by presence of user-specific links",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page opened with login form visible"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id='plg_usr_login_name']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Element located"
    },
    {
      "action_type": "clear",
      "target": "//*[@id='plg_usr_login_name']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='plg_usr_login_name']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "'admin' typed into field"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id='plg_usr_password']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Element located"
    },
    {
      "action_type": "clear",
      "target": "//*[@id='plg_usr_password']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Field cleared"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='plg_usr_password']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "'admin' typed into field"
    },
    {
      "action_type": "find_element",
      "target": "//*[@id='next_page']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Element located"
    },
    {
      "action_type": "click",
      "target": "//*[@id='next_page']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Page reloaded showing logged-in state (e.g., 'My profile', 'Sign out' links)"
    }
