{
  "case_goal": "Verify that an admin user can unlock a photo album.",
  "summary": "Log in as admin, navigate to the Photos section, and click the 'Unlock album' button for an existing album to unlock it.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Overview page loads with sign-in form visible"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='plg_usr_login_name']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Username field contains 'admin'"
    },
    {
      "action_type": "send_keys",
      "target": "//*[@id='plg_usr_password']",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field contains 'admin'"
    },
    {
      "action_type": "click",
      "target": "//*[@id='next_page']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login successful; page reloads with 'Sign out' link visible and admin navigation menu"
    },
    {
      "action_type": "click",
      "target": "//*[@id='photo']",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigate to photo albums page; 'Create album' link and existing album(s) visible"
    },
    {
      "action_type": "click",
      "target": "/html/body/div[2]/div/div[2]/div/div[2]/div/div/div/button",
      "value": "",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/photos/photos.php",
      "expected_result": "Button with text 'Unlock album' is clicked; after action, 'Unlock album' button disappears and 'Lock album' hidden option appears"
    }
  ]
}