{
  "case_goal": "Verify that an announcement can be copied and saved successfully.",
  "summary": "Admin logs in, navigates to Announcements, selects the 'Copy' option from the dropdown menu for an existing announcement, modifies the description in the rich text editor, and saves the copy. The copied announcement should appear in the list.",
  "steps": [
    {
      "action_type": "get",
      "target": "url",
      "value": "http://admidio-old.local:8082/adm_program/overview.php",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Overview page loaded with login form visible."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"plg_usr_login_name\"]",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Login field filled with 'admin'."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=//*[@id=\"plg_usr_password\"]",
      "value": "admin",
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Password field filled."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"next_page\"]",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Logged in as admin, redirected to overview page with admin menu."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"announcements\"]",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/overview.php",
      "expected_result": "Navigated to Announcements page."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"dropdownMenuButton\"]",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php",
      "expected_result": "Dropdown menu opens with Copy, Edit, Delete options."
    },
    {
      "action_type": "click",
      "target": "xpath=/html/body/div[2]/div/div[2]/div/div[2]/div[1]/div/div/a[1]",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements.php",
      "expected_result": "Navigated to copy announcement form with pre-filled data."
    },
    {
      "action_type": "switch_frame",
      "target": "xpath=//*[@id=\"cke_1_contents\"]/iframe",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements_new.php?ann_uuid=2954c02b-e4ee-43bc-aadd-0f921d94b856&copy=1&headline=Announcements",
      "expected_result": "Switched to rich text editor iframe for description."
    },
    {
      "action_type": "send_keys",
      "target": "xpath=/html/body",
      "value": "test",
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements_new.php?ann_uuid=2954c02b-e4ee-43bc-aadd-0f921d94b856&copy=1&headline=Announcements",
      "expected_result": "Description field cleared and typed 'test'."
    },
    {
      "action_type": "click",
      "target": "xpath=//*[@id=\"btn_save\"]",
      "value": null,
      "page_url": "http://admidio-old.local:8082/adm_program/modules/announcements/announcements_new.php?ann_uuid=2954c02b-e4ee-43bc-aadd-0f921d94b856&copy=1&headline=Announcements",
      "expected_result": "Copy saved, redirected back to announcements list with two entries."
    }
  ]
}